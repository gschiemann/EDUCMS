{
  "name": "edu-cms-backend",
  "packageManager": "pnpm@9.0.0",
  "version": "1.0.0",
  "description": "Secure multi-tenant School CMS API",
  "scripts": {
    "start": "pnpm --filter api run start:prod",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "postinstall": "pnpm run db:generate",
    "db:generate": "pnpm --filter @cms/database run db:generate",
    "db:push": "pnpm --filter @cms/database run db:push",
    "db:seed": "pnpm --filter @cms/database run db:seed",
    "db:seed:demo": "node packages/database/prisma/seed-multilocation-demo.mjs",
    "db:seed:demo:clean": "node packages/database/prisma/seed-multilocation-demo.mjs --clean",
    "db:setup": "pnpm run db:push && pnpm run db:seed",
    "db:backfill-hashes": "pnpm --filter @cms/database exec tsx ../../scripts/backfill-asset-hashes.ts",
    "worktrees:status": "bash scripts/cleanup-worktrees.sh",
    "worktrees:clean": "bash scripts/cleanup-worktrees.sh --execute --branches",
    "hygiene": "bash scripts/hygiene-check.sh",
    "hygiene:deps": "bash scripts/hygiene-check.sh --deps",
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "a11y:ci": "pnpm --filter web run a11y:ci",
    "lhci": "pnpm --filter web run lhci",
    "mobile-perf-guard": "node apps/web/tools/check-mobile-perf.cjs",
    "preflight": "pnpm install --frozen-lockfile --lockfile-only && pnpm --filter @cms/api-types build && pnpm --filter @cms/auth-core build && pnpm --filter @cms/ws-events build && pnpm --filter @cms/scoreboard-cts build && pnpm --filter @cms/signage-design build && pnpm --filter api build && pnpm --filter web build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@cms/api-types": "workspace:*",
    "@cms/auth-core": "workspace:*",
    "@cms/ws-events": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "helmet": "^7.1.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "@wdio/cli": "^9.30.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.10.6",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "comment-overrides": "Patched floors for transitive advisories, all within-major (patch/minor) bumps. First block: dev-only toolchains (the @wdio/cli Android-E2E tree). Second block (2026-07-10 prod-audit remediation): PROD-graph transitives — ws (@nestjs/platform-ws + @supabase/realtime-js, memory-exhaustion DoS), multer 2.x (@nestjs/platform-express upload path, nested-field DoS), undici 7.x (cheerio/jsdom scraping, TLS-bypass + WS DoS), plus moderate cleanups (dompurify, postcss, qs, uuid, ip-address, brace-expansion, js-yaml, @opentelemetry/core). Selectors are version-scoped so other majors (e.g. multer 1.x direct dep, js-yaml 3.x, uuid 8.x) are untouched.",
    "overrides": {
      "undici@<6.24.0": "^6.24.0",
      "sharp@<0.35.0": "^0.35.3",
      "basic-ftp@<5.3.1": "^5.3.1",
      "fast-uri@<3.1.4": "^3.1.4",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "tmp@<0.2.6": "^0.2.6",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "multer@>=2.0.0 <2.2.0": "^2.2.0",
      "undici@>=7.0.0 <7.28.0": "^7.28.0",
      "dompurify@>=3.0.0 <3.4.11": "^3.4.11",
      "postcss@>=8.0.0 <8.5.10": "^8.5.10",
      "qs@>=6.0.0 <6.15.2": "^6.15.2",
      "uuid@>=13.0.0 <13.0.1": "^13.0.1",
      "ip-address@>=10.0.0 <10.1.1": "^10.1.1",
      "brace-expansion@>=5.0.0 <5.0.6": "^5.0.6",
      "js-yaml@>=4.0.0 <4.2.0": "^4.2.0",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "^2.8.0"
    }
  }
}
