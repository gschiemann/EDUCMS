{
  "name": "edu-cms-backend",
  "packageManager": "pnpm@9.0.0",
  "version": "1.0.0",
  "description": "Secure multi-tenant School CMS API",
  "scripts": {
    "start": "pnpm --filter api run start:prod",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "postinstall": "pnpm run db:generate",
    "db:generate": "pnpm --filter @cms/database run db:generate",
    "db:push": "pnpm --filter @cms/database run db:push",
    "db:seed": "pnpm --filter @cms/database run db:seed",
    "db:seed:demo": "node packages/database/prisma/seed-multilocation-demo.mjs",
    "db:seed:demo:clean": "node packages/database/prisma/seed-multilocation-demo.mjs --clean",
    "db:setup": "pnpm run db:push && pnpm run db:seed",
    "db:backfill-hashes": "pnpm --filter @cms/database exec tsx ../../scripts/backfill-asset-hashes.ts",
    "worktrees:status": "bash scripts/cleanup-worktrees.sh",
    "worktrees:clean": "bash scripts/cleanup-worktrees.sh --execute --branches",
    "hygiene": "bash scripts/hygiene-check.sh",
    "hygiene:deps": "bash scripts/hygiene-check.sh --deps",
    "dev:api": "pnpm --filter api run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "a11y:ci": "pnpm --filter web run a11y:ci",
    "lhci": "pnpm --filter web run lhci",
    "mobile-perf-guard": "node apps/web/tools/check-mobile-perf.cjs",
    "preflight": "pnpm install --frozen-lockfile --lockfile-only && pnpm --filter @cms/api-types build && pnpm --filter @cms/auth-core build && pnpm --filter @cms/ws-events build && pnpm --filter @cms/scoreboard-cts build && pnpm --filter api build && pnpm --filter web build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@cms/api-types": "workspace:*",
    "@cms/auth-core": "workspace:*",
    "@cms/ws-events": "workspace:*",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.4",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "@wdio/cli": "^9.27.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.9.6",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "comment-overrides": "Patched floors for transitive advisories. All scoped to dev-only toolchains (the @wdio/cli Android-E2E tree) — none ship to the prod container. Patch-level within-major bumps; revisit when @wdio/cli is upgraded.",
    "overrides": {
      "undici@<6.24.0": "^6.24.0",
      "basic-ftp@<5.3.1": "^5.3.1",
      "fast-uri@<3.1.2": "^3.1.2",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "tmp@<0.2.6": "^0.2.6"
    }
  }
}
