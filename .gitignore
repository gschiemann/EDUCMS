node_modules/
.next/
dist/
build/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/**/.env
packages/**/.env
.DS_Store
*.pem
*.sqlite

# Temp files
_tmp_*

# Runtime upload dirs — operator/tenant content must never be committed
# (repo is public). Dev writes here via UPLOAD_DIR default ./uploads;
# production uses /tmp/uploads. Keep the dir via a tracked .gitkeep.
apps/api/uploads/
*.tsbuildinfo

# IDEs
.idea/
.vscode/

# Turborepo
.turbo/

# Claude Code local session data stays untracked — EXCEPT shared agent
# definitions under .claude/agents/, which are version-controlled so the
# template-designer agent (and any future agents) persist across re-clones
# and are shared with the team.
.claude/*
!.claude/agents/

# Playwright
test-results/
playwright-report/

.vercel
.mcp.json
scratch/

# Agent-tooling local config — NEVER commit. .codex/config.toml holds live
# secrets (Supabase service_role JWT, DB password, Railway + GitHub tokens);
# AGENTS.md is local agent scratch. Repo is PUBLIC — a stray `git add .`
# must not publish these. (Added 2026-06-08, launch-readiness audit.)
/.codex/
/AGENTS.md

# Backup tarballs (the documented `edu-cms-backup-*.tar.gz` procedure writes
# these to repo root) + private keys/certs — never commit to a public repo.
*.tar.gz
*.tgz
edu-cms-backup-*
*.key
*.pfx
*.p12
*.crt
