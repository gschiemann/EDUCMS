# Copy to .env and adjust. Never commit .env.

# Dev default: local SQLite file (zero setup).
# Production target: Postgres (e.g. Supabase) — swap provider in prisma/schema.prisma
# and point this at the connection string.
DATABASE_URL="file:./dev.db"

# Where uploaded receipt/document files are stored in dev (local disk).
# Production target: object storage (e.g. Supabase Storage) via src/lib/storage.ts.
UPLOAD_DIR="var/uploads"
