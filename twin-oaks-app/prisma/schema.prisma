// Twin Oaks OS — V1 data model (financial core + equipment).
//
// Production target is Postgres (Vercel deployment). Money is stored as
// integer cents, and enum-like fields are strings whose allowed values live
// in src/lib/domain.ts — keep that file the source of truth.
//
// Offline-only local dev without any Postgres: flip provider to "sqlite",
// set DATABASE_URL="file:./dev.db", run `pnpm db:push && pnpm db:seed`
// (the schema is written to work on both), and don't commit the flip.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id        String    @id @default(cuid())
  name      String    @unique
  notes     String?
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

// A receipt is first-class: it can exist before it is categorized (the Inbox),
// and it permanently stores the original image/PDF once attached.
model Receipt {
  id            String    @id @default(cuid())
  status        String    @default("INBOX") // see RECEIPT_STATUSES in src/lib/domain.ts
  filePath      String? // storage key under UPLOAD_DIR; null = record without a file yet
  fileName      String?
  mimeType      String?
  fileSize      Int?
  vendorName    String?
  receiptDate   DateTime?
  totalCents    Int?
  salesTaxCents Int?
  paymentMethod String?
  receiptNumber String?
  notes         String?
  expenseId     String?
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([expenseId])
}

model Expense {
  id                 String              @id @default(cuid())
  date               DateTime
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName         String? // denormalized for fast entry + search
  description        String
  amountCents        Int
  salesTaxCents      Int?
  paymentMethod      String?
  division           String // FARM | TECH | SHARED — see DIVISIONS
  accountingCategory String // bookkeeping/tax category — see ACCOUNTING_CATEGORIES
  managementCategory String? // free-form drill-down path, e.g. "Farm Equipment > Tractor #1 > Hydraulic system"
  businessPurpose    String?
  assetId            String?
  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  taxYear            Int
  // Tax-safety principle: the app NEVER assumes deductibility. New expenses
  // default to NEEDS_REVIEW until a human classifies them.
  taxStatus          String              @default("NEEDS_REVIEW") // see TAX_STATUSES
  isCapital          Boolean             @default(false) // flagged major purchase (depreciation / §179 review)
  notes              String?
  receipts           Receipt[]
  maintenanceRecords MaintenanceRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([date])
  @@index([taxYear, division])
  @@index([accountingCategory])
  @@index([taxStatus])
  @@index([assetId])
}

model Income {
  id            String   @id @default(cuid())
  date          DateTime
  source        String? // customer/buyer name (free-form until Customers arrive in V2)
  description   String
  amountCents   Int
  division      String // FARM | TECH | SHARED
  category      String // see INCOME_CATEGORIES
  paymentMethod String?
  notes         String?
  taxYear       Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([taxYear, division])
}

// Equipment / capital asset profile: tractors, printers, trailers, buildings…
model Asset {
  id                 String              @id @default(cuid())
  name               String // "Tractor #1", "Bambu H2D #1"
  assetTag           String? // internal asset ID
  kind               String // see ASSET_KINDS
  division           String // FARM | TECH | SHARED
  manufacturer       String?
  model              String?
  serialNumber       String?
  year               Int?
  purchaseDate       DateTime?
  purchasePriceCents Int?
  purchasedFrom      String?
  financingNotes     String?
  warrantyNotes      String?
  currentHours       Float? // engine hours (tractors, printers use print-hours)
  currentMileage     Float? // vehicles/trailers
  status             String              @default("ACTIVE") // ACTIVE | SOLD | RETIRED
  notes              String?
  expenses           Expense[]
  maintenance        MaintenanceRecord[]
  mileageLogs        MileageLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([kind])
  @@index([division])
}

// ————— V2: the revenue loop (SPEC §§14–17) + mileage (§19) —————

model Customer {
  id        String    @id @default(cuid())
  name      String
  company   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  invoices  Invoice[]
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique // "INV-001"
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  division      String // FARM | TECH | SHARED
  // Stored base status: DRAFT | SENT | CANCELLED. Paid/partially-paid/overdue
  // are DERIVED from payments + dueDate — never stored, never drifts.
  status        String        @default("DRAFT")
  issueDate     DateTime
  dueDate       DateTime?
  terms         String?
  notes         String?
  subtotalCents Int           @default(0)
  salesTaxCents Int           @default(0)
  totalCents    Int           @default(0)
  taxYear       Int
  lines         InvoiceLine[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([taxYear])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder      Int     @default(0)
  description    String
  quantity       Float   @default(1)
  unitPriceCents Int
  totalCents     Int
}

model Payment {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date        DateTime
  amountCents Int
  method      String?
  checkNumber String?
  notes       String?
  incomeId    String? // the auto-created Income row that puts this payment on the books
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([invoiceId])
}

// Mileage (SPEC §19). Tax-safety: we record miles; the deduction rate and
// treatment are the accountant's call.
model MileageLog {
  id             String   @id @default(cuid())
  date           DateTime
  startLocation  String?
  destination    String
  purpose        String
  customerName   String?
  vehicleAssetId String?
  vehicle        Asset?   @relation(fields: [vehicleAssetId], references: [id], onDelete: SetNull)
  startOdometer  Float?
  endOdometer    Float?
  miles          Float
  notes          String?
  taxYear        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([taxYear])
}

model MaintenanceRecord {
  id             String   @id @default(cuid())
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date           DateTime
  hoursAtService Float?
  category       String // see MAINTENANCE_CATEGORIES
  description    String
  partsCostCents Int?
  laborCostCents Int?
  vendorName     String?
  notes          String?
  expenseId      String?
  expense        Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([assetId, date])
}
