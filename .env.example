# -- Capacity early-warning, efficiency and egress accounting --
# Percent of a plan limit at which the capacity early-warning goes critical (emails immediately on
# escalation).
# CAPACITY_CRITICAL_PCT=85
# Optional JSON overriding plan limits: dbBytes, dbConnections, storageBytes, redisBytes, memoryBytes,
# eventLoopLagMs, pairedScreens. [fails open]
# CAPACITY_LIMITS=
# Percent of a plan limit at which the capacity early-warning emails the owner (at most once per metric
# per day).
# CAPACITY_WARN_PCT=70
# Stops the hourly capacity sampler (database, storage, tables, screens, Redis, API memory, event-loop
# lag) and its emails. [kill switch; fails open; set with: 1]
# CAPACITY_WATCH_DISABLED=false
# Efficiency counters are flushed after this many recorded events.
# EFFICIENCY_FLUSH_EVERY_N=200
# Efficiency counters are flushed at least this often, in ms.
# EFFICIENCY_FLUSH_MS=10000
# Smallest hourly egress, in GB, that can be flagged as an anomaly (the 2026-05-23 cache-miss storm was
