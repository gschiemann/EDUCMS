generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                              String             @id @default(uuid())
  parentId                        String?            @map("parent_id")
  name                            String
  slug                            String             @unique
  emergencyStatus                 String             @default("INACTIVE") @map("emergency_status")
  /// The INCIDENT TYPE of the active tenant-wide emergency (LOCKDOWN /
  /// EVACUATE / WEATHER / HOLD / SECURE / MEDICAL). Added 2026-07-25.
  /// emergencyStatus holds the SEVERITY (CRITICAL/HIGH/...), and the two enums
  /// are disjoint, so before this column the incident type was LOST on a
  /// tenant-scope trigger and screens rendered "CRITICAL PROTOCOL ACTIVE"
  /// instead of LOCKDOWN or EVACUATE — opposite life-safety actions.
  emergencyType                   String?            @map("emergency_type")
  createdAt                       DateTime           @default(now()) @map("created_at")
  // 2026-07-23 — tenant soft-delete (archive). Hard-delete is architecturally
  // impossible for any tenant with audit history (audit_logs FK RESTRICT + the
  // §16 immutability trigger), so archiving is the supported way to retire a
  // location / clean up test accounts. Reversible: archive sets this, unarchive
  // clears it. Archived tenants are EXCLUDED from every fleet/location/list/
  // count/cascade query (so an archived child stops making a parent read as
  // multi-location "HQ"), but remain reachable by direct id (auth, unarchive,
  // audit lineage) — soft-delete, never a data wipe.
  archivedAt                      DateTime?          @map("archived_at")
  emergencyPlaylistId             String?            @map("emergency_playlist_id")
  panicEvacuatePlaylistId         String?            @map("panic_evacuate_playlist_id")
  panicLockdownPlaylistId         String?            @map("panic_lockdown_playlist_id")
  panicWeatherPlaylistId          String?            @map("panic_weather_playlist_id")
  // SRP (Standard Response Protocol) expansion — most US K-12 districts
  // train on these specific actions. Hold + Secure + Medical added so
  // operators don't have to over-trigger Lockdown for hallway clearing
  // (Hold), outside-only threats (Secure), or medical events (Medical).
  panicHoldPlaylistId             String?            @map("panic_hold_playlist_id")
  panicSecurePlaylistId           String?            @map("panic_secure_playlist_id")
  panicMedicalPlaylistId          String?            @map("panic_medical_playlist_id")
  // Per-orientation portrait variants. When a portrait screen (Nova
  // 4K vertical wall, hallway pillar, etc.) fetches the manifest
  // during an emergency, the controller prefers the *_portrait_*
  // playlist if configured and falls back to the landscape playlist
  // above if not. Admin configures both once; each screen auto-picks.
  // `emergencyPortraitPlaylistId` is the currently-active portrait
  // playlist (set atomically at trigger time alongside emergencyPlaylistId).
  emergencyPortraitPlaylistId     String?            @map("emergency_portrait_playlist_id")
  panicEvacuatePortraitPlaylistId String?            @map("panic_evacuate_portrait_playlist_id")
  panicLockdownPortraitPlaylistId String?            @map("panic_lockdown_portrait_playlist_id")
  panicWeatherPortraitPlaylistId  String?            @map("panic_weather_portrait_playlist_id")
  panicHoldPortraitPlaylistId     String?            @map("panic_hold_portrait_playlist_id")
  panicSecurePortraitPlaylistId   String?            @map("panic_secure_portrait_playlist_id")
  panicMedicalPortraitPlaylistId  String?            @map("panic_medical_portrait_playlist_id")
  assetFolders                    AssetFolder[]
  assets                          Asset[]
  auditLogs                       AuditLog[]
  bugs                            Bug[]
  playlists                       Playlist[]
  schedules                       Schedule[]
  screenGroups                    ScreenGroup[]
  screens                         Screen[]
  templates                       Template[]
  templateVersions                TemplateVersion[]
  notifications                   Notification[]
  parent                          Tenant?            @relation("TenantHierarchy", fields: [parentId], references: [id])
  children                        Tenant[]           @relation("TenantHierarchy")
  users                           User[]
  ssoConfig                       TenantSSOConfig?
  cleverDistrictId                String?            @unique @map("clever_district_id")
  cleverAccessToken               String?            @map("clever_access_token")
  cleverConnectedAt               DateTime?          @map("clever_connected_at")
  cleverSyncLogs                  CleverSyncLog[]
  userInvites                     UserInvite[]
  // VenueOS Sports — Phase 2 persistent player-stats / records engine.
  // Back-relations for the tenant-owned persistent identity + aggregate
  // tables (see the Sports Phase 2 block near the end of this file).
  sportsTeams                     Team[]
  sportsPersons                   SportsPerson[]
  playerSeasonStats               PlayerSeasonStat[]
  playerCareerStats               PlayerCareerStat[]
  statRecords                     StatRecord[]
  statMilestoneDefs               StatMilestoneDef[]
  playerMilestones                PlayerMilestone[]
  // USB sneakernet ingest (Sprint 7B). Off by default; admins opt in per
  // tenant. The HMAC key signs every USB bundle's manifest.json so a
  // random/stolen stick can't push content to a paired screen. Rotated
  // by an admin via POST /tenants/me/usb-ingest-key/rotate.
  // Location-based emergency mode (Sprint 8b operator UX). Off by
  // default — tenants get the simple "every screen plays the same panic
  // content" workflow. Admin opts in via Settings → Emergency to unlock
  // floor plans + per-screen emergency content overrides. While this
  // flag is OFF the manifest endpoint ignores any per-screen override
  // columns even if they're populated, so flipping the toggle is a
  // reversible no-op for the player fleet.
  locationBasedEmergencyEnabled   Boolean            @default(false) @map("location_based_emergency_enabled")
  // Auto-update for paired Android players (2026-04-27). Operator:
  // "we shouldnt be auto updating screens unless we check a box or
  // something on that... i would hate to break a perfectly good
  // working screen with an update."
  // OFF (default): /player/update-check returns uptoDate=true unless
  // the admin manually clicked Push for that specific screen (the
  // controller stores Screen.forceApkUpdatePendingAt and respects a
  // 30-min window). ON: kiosks pull updates on their own 6h cadence.
  autoUpdatePlayerEnabled         Boolean            @default(false) @map("auto_update_player_enabled")
  // OTA maintenance window (Sprint 11, Phase A).
  // Operator: "we cant have screens flashing all the time" + "find the
  // bigger picture solution for uninterrupted service across all
  // screens, all customer, all playlists".
  //
  // When set: even if force_apk_update_pending_at is set, the
  // /update-check endpoint only returns the download URL during
  // [otaWindowStart, otaWindowEnd] in `otaWindowTimezone` local time.
  // Outside that window it returns uptoDate=true; the force flag
  // stays set until the next window opens. The dashboard's "Push
  // update" dialog has an "Apply now (override window)" checkbox
  // that flips a per-screen override flag for one-shot emergency
  // pushes.
  //
  // Storage format: HH:MM (24-hour, zero-padded). Wraparound is
  // supported — start=22:00, end=04:00 means "10 PM to 4 AM next day."
  // Timezone is an IANA name (America/Chicago, etc.). Null fields
  // mean "no window configured" → updates fire immediately (current
  // behavior, backward-compatible).
  otaWindowStart                  String?            @map("ota_window_start") // "HH:MM"
  otaWindowEnd                    String?            @map("ota_window_end") // "HH:MM"
  otaWindowTimezone               String?            @map("ota_window_timezone") // IANA tz
  // Sprint 11 Phase B — canary rollout. canaryFleetPercent < 100 means
  // only the deterministic hash bucket of screens (0..pct-1 mod 100)
  // is eligible for the latest APK; the rest get `uptoDate:true` even
  // if force flag is set. After `canarySoakHours` (default 24) with no
  // INSTALL ERROR in the canary cohort, a cron auto-promotes the
  // percent to 100 — guarantees a bad version can't blast the whole
  // fleet without a human-detectable soak window first.
  //
  // canaryFleetPercent  100 = full rollout (default), 0 = OTA disabled,
  //                     anything else = canary cohort %
  // canarySetAt         when canaryFleetPercent was last lowered;
  //                     starts the soak timer
  // canaryAutoPromote   if true, cron promotes to 100 after soak;
  //                     if false, operator must promote manually
  canaryFleetPercent              Int                @default(100) @map("canary_fleet_percent")
  canarySetAt                     DateTime?          @map("canary_set_at")
  canaryAutoPromote               Boolean            @default(true) @map("canary_auto_promote")
  canarySoakHours                 Int                @default(24) @map("canary_soak_hours")
  usbIngestEnabled                Boolean            @default(false) @map("usb_ingest_enabled")
  usbIngestKey                    String?            @map("usb_ingest_key") // 64-char hex (HMAC-SHA256 secret)
  usbIngestKeyRotatedAt           DateTime?          @map("usb_ingest_key_rotated_at")
  usbIngestEvents                 UsbIngestEvent[]
  games                           Game[]
  sponsors                        Sponsor[]
  // Industry vertical — drives default templates, widget palette, and
  // pricing tier. Tenants are isolated regardless; this is just metadata
  // + UI personalization.
  vertical                        String             @default("K12") // K12 | GYM | RETAIL | CORPORATE | QSR | FASHION | BAR | HEALTHCARE | HOSPITALITY | RESTAURANT | SPORTS — canonical list: packages/api-types/src/verticals.ts (VERTICALS)
  // 2026-05-25 — Per-location physical address. Sprint 8's fleet map
  // view plots tenants + screens by lat/lng; collecting address here
  // (optional at signup + on add-location) means every new account
  // auto-populates the map without manual placement. Geocoded via
  // OpenStreetMap Nominatim (free, rate-limited) on save when address
  // changes; manual lat/lng entry is also supported.
  address                         String?            @map("address")
  latitude                        Float?             @map("latitude")
  longitude                       Float?             @map("longitude")
  // BYOK AI integration (2026-05-04) — operator's own provider
  // credentials, so cost shifts to them. ai_provider null means use
  // platform default key (process.env.ANTHROPIC_API_KEY) — current
  // free-trial behavior. Encrypted key never returned to clients.
  aiProvider                      String?            @map("ai_provider") // 'anthropic' | 'openai' | 'google'
  // 2026-05-25 — operator-selected model id from the catalog in
  // apps/api/src/ai/ai-providers.ts. Null means "use the provider's
  // default cheapest model" — same as legacy behavior pre-picker.
  // Validated against isKnownModel() before dispatch.
  aiModel                         String?            @map("ai_model")
  aiKeyEncrypted                  String?            @map("ai_key_encrypted")
  aiKeySetAt                      DateTime?          @map("ai_key_set_at")
  aiKeySetByUserId                String?            @map("ai_key_set_by_user_id")
  // Platform free-tier monthly quota tracking. month = 'YYYY-MM'.
  // Cap value lives in AI_FREE_TIER_CAP env var (default 200) so we
  // can tune it globally without a migration. BYOK tenants bypass.
  aiPlatformUsageMonth            String?            @map("ai_platform_usage_month")
  aiPlatformUsageCount            Int                @default(0) @map("ai_platform_usage_count")
  // Per-screen billing meter. One License row per Tenant; absence means
  // "Pilot" (free tier with cap of 3 screens, no expiry). License flips
  // when an admin runs a Stripe checkout or the SUPER_ADMIN comps seats.
  license                         License?
  // Auto-branding (Sprint 9). One-to-one; absence means "default theme."
  branding                        TenantBranding?
  // Submit-for-review workflow (Sprint 1.5).
  submissions                     Submission[]
  // Org-wide "require approval before any content goes live" gate
  // (Appspace-parity enterprise control, 2026-06-26). OFF by default —
  // single-operator tenants keep today's behavior (a CONTRIBUTOR
  // staging a schedule uses the explicit "Send for review" flow only
  // when they choose to). When ON, a CONTRIBUTOR who publishes/schedules
  // content is FORCED through the existing submit-for-review queue: the
  // schedule is staged as a draft AND a Submission review record is
  // auto-created so an admin must approve it before it goes live.
  // Admins (SCHOOL_ADMIN / DISTRICT_ADMIN / SUPER_ADMIN) bypass the gate —
  // they ARE the approvers. Settable only by DISTRICT_ADMIN / SUPER_ADMIN.
  requireContentApproval          Boolean            @default(false) @map("require_content_approval")
  // Floor plans (Sprint 8b indoor map).
  floorPlans                      FloorPlan[]
  // Phase D5 touch analytics.
  touchEvents                     TouchEvent[]
  // 2026-05-25 Developer area: tenant-scoped REST tokens + outbound
  // webhooks. Cascade-delete on tenant removal so a wiped tenant
  // doesn't leave orphaned credentials sitting in the DB.
  apiKeys                         TenantApiKey[]
  webhooks                        TenantWebhook[]
  // Scheduled screen on/off windows (display-control, 2026-08-13).
  displaySchedules                DisplaySchedule[]

  @@map("tenants")
}

/// Tenant-scoped REST API tokens (Developer area, 2026-05-25).
///
/// Token format at issue time: `vos_<32-hex-chars>`. The `prefix`
/// column stores the first 8 chars of the hex portion for O(1) index
/// lookup at request time; `hashedSecret` is a bcrypt hash of the FULL
/// token (so a DB dump alone can't be replayed against the API). The
/// plaintext is shown to the operator ONCE on creation and never again.
///
/// `role` is one of the AppRole strings — JwtAuthGuard treats an API-key
/// request identically to a user-JWT request for RBAC purposes, except
/// `userId` is null on AuditLog rows (machine identity).
model TenantApiKey {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  prefix          String    @unique
  hashedSecret    String    @map("hashed_secret")
  role            String
  /// ACC-06 follow-up (2026-08-03) — PER-KEY LEAST PRIVILEGE.
  ///
  /// ACC-06 could only express "an API key may not reach the emergency
  /// routes" as a hard-coded URL-prefix deny in JwtAuthGuard, because this
  /// model had nowhere to record what a key IS allowed to do. Result: every
  /// key carried its whole ROLE's authority across every route family — a
  /// menu-board integration's token could also rewrite schedules and delete
  /// screens.
  ///
  /// Shape: JSON-encoded string array of scope ids, e.g.
  /// `["content:write","screens:read"]`. Same encoding as
  /// `TenantWebhook.events` — cheap, and the set per key is tiny.
  /// Vocabulary + path mapping: apps/api/src/api-keys/api-key-scopes.ts.
  ///
  /// NULL is meaningful and is NOT the same as `[]`:
  ///   NULL → key minted before scopes existed (or explicitly minted
  ///          unrestricted). No scope narrowing; role + the guard's denied-
  ///          path list still apply. This is what keeps every EXISTING key
  ///          working — the column is additive with no backfill.
  ///   []   → an explicit grant of NOTHING. Every route is refused.
  /// Either way the emergency prefix stays denied: no scope grants it, and
  /// the guard's prefix deny runs first regardless.
  scopes          String?   @map("scopes")
  expiresAt       DateTime? @map("expires_at")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_api_keys")
}

/// Tenant-scoped outbound webhooks (Developer area, 2026-05-25).
///
/// `events` is a JSON-encoded string array of subscribed event types
/// (e.g. ["emergency.triggered", "emergency.cleared"]). Cheaper than
/// a many-to-many table for the typical "subscribe to 1-3 events"
/// usage pattern. WebhookDispatchService loads all active webhooks for
/// a tenant, parses the JSON, and filters in-memory before POSTing.
///
/// `signingSecret` is the HMAC-SHA256 secret the receiver uses to
/// verify the X-VenueOS-Signature header on incoming POSTs. Returned
/// to the operator ONCE at creation; rotating means delete + recreate.
model TenantWebhook {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  name               String
  url                String
  events             String    @default("[]")
  signingSecret      String    @map("signing_secret")
  isActive           Boolean   @default(true) @map("is_active")
  lastDeliveryAt     DateTime? @map("last_delivery_at")
  lastDeliveryStatus Int?      @map("last_delivery_status")
  lastDeliveryError  String?   @map("last_delivery_error")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdByUserId    String?   @map("created_by_user_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  @@index([tenantId, isActive])
  @@map("tenant_webhooks")
}

/// Outbound webhook delivery record + retry ledger (Audit P1-5, 2026-05-28).
///
/// Before this, WebhookDispatchService only stamped lastDelivery* on the
/// TenantWebhook row — clobbered by the next event, with NO retry. A
/// receiver down for 8s during a lockdown lost `emergency.triggered`
/// permanently. This table makes every delivery durable and gives failed
/// ones a bounded exponential-backoff retry.
///
/// Multi-replica safety: WebhookRetryWorker claims due rows with an atomic
/// `UPDATE ... WHERE id IN (... FOR UPDATE SKIP LOCKED) RETURNING` so two
/// replicas never double-deliver the same row.
///
/// The original signed `body` + `signedTimestamp` are persisted so a retry
/// reproduces a byte-identical payload AND a byte-identical
/// HMAC-SHA256(secret, `${signedTimestamp}.${body}`) signature — receivers
/// that dedup on the signature/delivery-id see the retry as the same event.
model WebhookDelivery {
  id              String    @id @default(uuid())
  webhookId       String    @map("webhook_id")
  tenantId        String    @map("tenant_id")
  event           String
  // The exact JSON body that was (or will be) POSTed. Persisted so retries
  // reproduce a byte-identical payload + signature.
  body            String
  // UNIX-ms timestamp that was folded into the signature at first send.
  // Stays constant across retries so the signature stays constant.
  signedTimestamp BigInt    @map("signed_timestamp")
  // PENDING (queued/in-flight) | DELIVERED | FAILED (permanent, gave up).
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  // Null once terminal (DELIVERED / FAILED). Otherwise the earliest time a
  // worker may claim this row for the next attempt.
  nextRetryAt     DateTime? @map("next_retry_at")
  lastStatusCode  Int?      @map("last_status_code")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  webhook TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  // The worker's hot path: "give me every row due for retry."
  @@index([status, nextRetryAt])
  @@index([webhookId])
  @@map("webhook_deliveries")
}

// Auto-branding — scraped or manually configured visual identity that
// themes the admin UI (and, v1.5, player chrome / default templates).
// `palette`, `confidenceScores`, `heroImages`, and `rawSnapshot` are
// JSON blobs so we can iterate the schema of the design system without
// migrations. Only `tenantId` is required; everything else is optional
// to allow partial adoption (e.g., adopt the logo only, keep default
// colors).
model TenantBranding {
  id               String    @id @default(uuid())
  tenantId         String    @unique @map("tenant_id")
  // Human-readable product name for this tenant ("Lincoln HS Signage").
  displayName      String?   @map("display_name")
  tagline          String?
  // Per-tenant AI BRAND VOICE (Slice 1b, 2026-06-16). One or two sentences
  // describing how this venue's copy should sound ("warm, plainspoken, a
  // little playful; never corporate"). Prepended to the system prompt of
  // every AI copy surface (generate / touch-template / rewrite / chat-edit)
  // on top of the per-vertical voice clause. Nullable + additive.
  brandVoice       String?   @map("brand_voice")
  // Logo assets — all re-hosted in Supabase so we never hotlink the
  // source. logoSvgInline holds inline SVG markup for pixel-perfect
  // rendering when the source is SVG.
  logoUrl          String?   @map("logo_url")
  logoSvgInline    String?   @map("logo_svg_inline")
  faviconUrl       String?   @map("favicon_url")
  ogImageUrl       String?   @map("og_image_url")
  // Full palette with derived shades. Shape:
  // { primary, primaryHover, accent, accentHover, ink, surface,
  //   surfaceAlt, success, warn, danger, extras?: string[] }
  palette          Json?
  // Google-Fonts-matched names + CSS import URLs
  fontHeading      String?   @map("font_heading")
  fontBody         String?   @map("font_body")
  fontHeadingUrl   String?   @map("font_heading_url")
  fontBodyUrl      String?   @map("font_body_url")
  // Discovered hero photo candidates (up to 5, ranked)
  heroImages       Json?     @map("hero_images")
  // Provenance
  sourceUrl        String?   @map("source_url")
  scrapedAt        DateTime? @map("scraped_at")
  confidenceScores Json?     @map("confidence_scores")
  // Raw scrape result stored for re-derive without re-scraping
  rawSnapshot      Json?     @map("raw_snapshot")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model TenantSSOConfig {
  id                 String   @id @default(uuid())
  tenantId           String   @unique @map("tenant_id")
  provider           String // 'SAML' | 'OIDC'
  enabled            Boolean  @default(false)
  metadataUrl        String?  @map("metadata_url")
  entityId           String?  @map("entity_id")
  acsUrl             String?  @map("acs_url")
  x509Cert           String?  @map("x509_cert") // encrypted at rest
  oidcIssuer         String?  @map("oidc_issuer")
  oidcClientId       String?  @map("oidc_client_id")
  oidcClientSecret   String?  @map("oidc_client_secret") // encrypted at rest
  defaultRole        String   @default("RESTRICTED_VIEWER") @map("default_role")
  allowedEmailDomain String?  @map("allowed_email_domain")
  autoProvision      Boolean  @default(false) @map("auto_provision")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_sso_configs")
}

model User {
  id                   String               @id @default(uuid())
  tenantId             String               @map("tenant_id")
  email                String               @unique
  passwordHash         String               @map("password_hash")
  role                 String
  // 2026-06-16 — soft-delete (Wave 2). Hard delete 500'd on any user with
  // history: 3 required User relations default to FK Restrict and the
  // audit_logs userId relation can't SetNull because the audit table has an
  // immutability trigger. Soft-delete sets this, anonymizes the email to free
  // the @unique slot, and revokes sessions — every FK reference + the audit
  // trail stays intact. The user list + login filter on deletedAt IS NULL.
  deletedAt            DateTime?            @map("deleted_at")
  // 2026-05-11 — user profile names. Operator: "let's say Hi Greg
  // not gschiemann." Nullable so legacy rows keep loading; display
  // logic falls back to email-prefix when null. Two columns instead
  // of one `fullName` so we can do "Hi <firstName>" without
  // string-splitting at every call site (and so SSO imports from
  // Clever / Google have a clean target shape).
  firstName            String?              @map("first_name")
  lastName             String?              @map("last_name")
  // 2026-05-25 — operator wants signup + invite forms to collect
  // first name, last name, email, and (optional) phone, so 2FA via
  // SMS or password-reset via phone is possible later. Phone is
  // optional because TOTP / passkey 2FA paths don't need it; we
  // only collect it when the user explicitly opts in or when SMS
  // 2FA is the chosen factor. Stored E.164 normalized at write
  // time (e.g. "+12135551234"). Nullable so legacy rows + users
  // who never provided one keep loading.
  phone                String?              @map("phone")
  // 2FA enrollment state. See onboarding/auth service for the
  // canonical state machine; these are the raw fields.
  // - mfaTotpSecret: AES-encrypted-at-rest TOTP shared secret
  //   (base32). Null when TOTP not enrolled.
  // - mfaTotpVerifiedAt: timestamp of the FIRST successful TOTP
  //   verify after enrollment. Until set, the secret is provisional
  //   and not used for login. Prevents an interrupted enrollment
  //   from locking the user out.
  // - mfaBackupCodes: JSON array of Argon2id hashes of one-time
  //   recovery codes (10 generated at TOTP enrollment, single-use,
  //   each hash removed from array after consumption). Plain codes
  //   are SHOWN ONCE at enrollment, never stored.
  // - mfaRequired: tenant policy override on this user — set to
  //   true to force 2FA on next login even if user hasn't enrolled.
  //   Used by admin "require 2FA for this user" UX.
  // All four are nullable so the migration is purely additive and
  // existing users continue to log in with password-only until they
  // enroll. (Phase 2 work — fields reserved here so the migration
  // is one round trip.)
  mfaTotpSecret        String?              @map("mfa_totp_secret")
  mfaTotpVerifiedAt    DateTime?            @map("mfa_totp_verified_at")
  mfaBackupCodes       Json?                @map("mfa_backup_codes")
  mfaRequired          Boolean              @default(false) @map("mfa_required")
  canTriggerPanic      Boolean              @default(false) @map("can_trigger_panic")
  status               String               @default("ACTIVE")
  createdAt            DateTime             @default(now()) @map("created_at")
  assets               Asset[]
  auditLogs            AuditLog[]
  bugsReported         Bug[]                @relation("BugReporter")
  bugsApproved         Bug[]                @relation("BugApprover")
  createdTemplates     Template[]           @relation("TemplateCreator")
  templateVersions     TemplateVersion[]
  createdPlaylists     Playlist[]           @relation("PlaylistCreator")
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  cleverId             String?              @unique @map("clever_id")
  cleverRole           String?              @map("clever_role")
  passwordResets       PasswordResetToken[]
  passkeys             Passkey[]
  invitesSent          UserInvite[]         @relation("InviteInviter")
  invite               UserInvite?          @relation("InviteUser")
  notifications        Notification[]
  submissionsSubmitted Submission[]         @relation("SubmissionsSubmitted")
  submissionsDecided   Submission[]         @relation("SubmissionsDecided")

  // 2026-05-09 — perf audit found every admin-broadcast feature
  // (asset upload notify, submission notify, user list, SUPER_ADMIN
  // cross-tenant reads) does findMany({ where: { tenantId, ... } })
  // on this table with no supporting index. At low scale that's a
  // Seq Scan over a tiny table — fine. At 10k+ users it's the
  // BLOCKER for every fan-out. Composite on (tenantId, role, status)
  // covers the common variant: "active admins of this tenant" which
  // notify-loops use directly.
  @@index([tenantId])
  @@index([tenantId, role, status])
  @@map("users")
}

model CleverSyncLog {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  syncStartedAt   DateTime  @default(now()) @map("sync_started_at")
  syncCompletedAt DateTime? @map("sync_completed_at")
  usersAdded      Int       @default(0) @map("users_added")
  usersUpdated    Int       @default(0) @map("users_updated")
  usersDisabled   Int       @default(0) @map("users_disabled")
  errorMessage    String?   @map("error_message")
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, syncStartedAt])
  @@map("clever_sync_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// 2026-05-25 — Passkey table reserved for Phase 3 (WebAuthn). Stores
// one row per registered authenticator (laptop Touch ID, phone Face
// ID, hardware key, etc.). A user can have many passkeys. Login can
// happen passwordless via any registered passkey, OR password +
// passkey (as the "something you have" factor in 2FA). Fields match
// the @simplewebauthn/server library's expected shape so the
// integration is direct:
//   credentialId      → public key ID from registration response
//   publicKey         → COSE-encoded public key (raw bytes)
//   counter           → replay-attack counter, bumped on every assert
//   transports        → "internal" / "usb" / "nfc" / "ble" / "hybrid"
//   deviceLabel       → user-set name ("MacBook Touch ID", "iPhone")
//   lastUsedAt        → most recent successful auth; used by the UI
//                       to sort the device list + warn on dormant keys
// On user deletion: cascade — passkeys without a user are useless.
model Passkey {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id") // base64url
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0) @map("counter")
  transports   String[]  @default([]) @map("transports")
  deviceLabel  String?   @map("device_label")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model UserInvite {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  email       String
  role        String
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  userId      String?   @unique @map("user_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  invitedBy   User      @relation("InviteInviter", fields: [invitedById], references: [id])
  user        User?     @relation("InviteUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@map("user_invites")
}

// Per-tenant license. The billing meter is the count of paired Screens
// (Screen.tenantId IS NOT NULL AND Screen.pairedAt IS NOT NULL). When
// register() would push currentSeats above seatLimit, we reject with a
// LICENSE_EXHAUSTED error and instruct the admin to add seats.
model License {
  id                       String    @id @default(uuid())
  tenantId                 String    @unique @map("tenant_id")
  tier                     String // PILOT | STANDARD | ENTERPRISE | EDU_DISTRICT | RESTAURANT_CHAIN | (custom)
  seatLimit                Int       @default(3) @map("seat_limit")
  billingMode              String    @default("CARD") @map("billing_mode") // CARD | INVOICE | PURCHASE_ORDER | COMP
  status                   String    @default("ACTIVE") // ACTIVE | PAST_DUE | SUSPENDED | CANCELLED
  monthlyPriceCents        Int?      @map("monthly_price_cents") // null for COMP / EDU_DISTRICT custom
  // Stripe wire-up slots — populated when the customer runs in-app
  // checkout. Empty for COMP, INVOICE, PURCHASE_ORDER customers.
  stripeCustomerId         String?   @map("stripe_customer_id")
  stripeSubscriptionId     String?   @map("stripe_subscription_id")
  // Expiry / renewal. Null = perpetual (e.g. PILOT, COMP).
  currentPeriodStart       DateTime? @map("current_period_start")
  currentPeriodEnd         DateTime? @map("current_period_end")
  expiresAt                DateTime? @map("expires_at")
  // Free-form notes from the SUPER_ADMIN (e.g. "manually comp'd 5 seats
  // through 2026-09-01 — ARRA grant").
  notes                    String?
  // 2026-05-26 P0-7 audit (Stripe webhook idempotency): the UNIX-second
  // creation timestamp of the most-recent Stripe event that mutated this
  // License. Stripe events are NOT ordered — a stale
  // `customer.subscription.updated` (status=active) can land AFTER an
  // `invoice.payment_failed` (status=past_due) and flip the License back
  // to ACTIVE incorrectly. The webhook handler rejects any state-flipping
  // event whose `event.created` is older than this stored value.
  stripeLastEventCreatedAt DateTime? @map("stripe_last_event_created_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at")
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

// 2026-05-26 P0-7 audit (Stripe webhook idempotency): one row per Stripe
// event id we've processed. Stripe retries on any 5xx and may re-deliver
// the same event.id. At webhook entry we INSERT here first — the unique
// primary key gives us atomic dedup at the database. A second delivery
// hits a P2002 unique-constraint violation and the handler short-circuits.
// `type` is kept purely for forensic readability of the table.
model ProcessedStripeEvent {
  id          String   @id // Stripe event.id (evt_*)
  type        String // event.type for forensics
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_stripe_events")
}

model UsbIngestEvent {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  screenId        String?  @map("screen_id")
  deviceSerial    String?  @map("device_serial") // USB stick volume serial
  bundleVersion   String?  @map("bundle_version") // version field from manifest.json
  assetCount      Int      @default(0) @map("asset_count")
  totalBytes      BigInt   @default(0) @map("total_bytes")
  emergencyAssets Boolean  @default(false) @map("emergency_assets") // true if bundle contained any emergency assets
  outcome         String // 'ACCEPTED' | 'REJECTED_SIGNATURE' | 'REJECTED_HASH' | 'CANCELLED_BY_OPERATOR' | 'PARTIAL'
  reason          String?
  operatorPin     String?  @map("operator_pin") // SHA-256 of pin used; never store the raw pin
  createdAt       DateTime @default(now()) @map("created_at")
  // MED-2 audit fix: cascade delete with the parent Tenant. RESTRICT
  // previously made any tenant that ever ingested a USB bundle
  // permanently undeletable.
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("usb_ingest_events")
}

model EmailLog {
  id        String    @id @default(uuid())
  toEmail   String    @map("to_email")
  subject   String
  body      String
  kind      String
  status    String    @default("QUEUED")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([status])
  @@index([toEmail])
  @@map("email_logs")
}

model ScreenGroup {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  name        String
  description String?
  // 2026-07-28 — frame-locked multi-screen sync. null/'off' = screens in
  // this group free-run exactly as before; 'locked' = every screen in the
  // group plays its (shared) schedule on the deterministic epoch-anchored
  // timeline + shared server clock, so content flips land within a frame
  // of each other. Nullable + additive: the entire fleet behaves byte-for-
  // byte identically until an operator flips a group to 'locked'.
  // Design: docs/research/2026-07-28-multiscreen-sync/00-DESIGN.md
  syncMode    String?    @map("sync_mode")
  createdAt   DateTime   @default(now()) @map("created_at")
  schedules   Schedule[]
  displaySchedules DisplaySchedule[]
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  screens     Screen[]

  @@map("screen_groups")
}

model Screen {
  id                                  String       @id @default(uuid())
  tenantId                            String?      @map("tenant_id")
  screenGroupId                       String?      @map("screen_group_id")
  name                                String
  location                            String?
  deviceFingerprint                   String       @unique @map("device_fingerprint")
  pairingCode                         String?      @unique @map("pairing_code")
  status                              String       @default("PENDING")
  lastPingAt                          DateTime?    @map("last_ping_at")
  pairedAt                            DateTime?    @map("paired_at")
  resolution                          String?
  // 2026-05-24 — operator-controllable orientation lock. Replaces the
  // old SCREEN_ORIENTATION_FULL_SENSOR behavior on stationary signage
  // hardware (Goodview, Taurus, BrightSign) that has no useful
  // accelerometer. Values: 'LANDSCAPE' | 'PORTRAIT' | 'AUTO'. Default
  // LANDSCAPE matches the pre-2026-05-24 effective behavior so every
  // already-paired kiosk continues to behave the same after migrate.
  orientation                         String       @default("LANDSCAPE")
  // 2026-05-26 — LED canvas dimensions. Some LED controllers (NovaStar
  // Taurus, SMART LED POSTER) report a frame buffer (typically 1920×1080)
  // that's WIDER than the physical LED's visible pixels — e.g. a single
  // 320×1080 portrait LED panel renders the leftmost 320 px and discards
  // the rest. Daisy-chained panels add 320 to the visible width per
  // panel (1=320, 2=640, ... 6=1920). The operator picks this on the
  // dashboard screen card (N-panel selector); manifest pushes it to the
  // player which sets --led-w / --led-h CSS vars so splash + content
  // anchor to the actual visible canvas. Null = use controller's native
  // viewport (no scaling, fine for regular landscape kiosks).
  canvasW                             Int?         @map("canvas_w")
  canvasH                             Int?         @map("canvas_h")
  // 2026-05-26 — content tile-repeat count for LED ribbons. A ribbon
  // is a single wide strip (e.g. 40ft long) where the same content is
  // intentionally repeated N times across the width so the score / logo
  // / sponsor stays visible from every viewing angle. Operator: "we
  // will repeat probably 4 times, every 10ft of ribbon". The player
  // wraps content in a flex grid with `repeats` children, each
  // rendering the same template/playlist at width = canvasW / repeats.
  // Default 1 = no tiling (normal canvas). Set this on the screen via
  // the dashboard's diagnostics drawer next to the canvas picker.
  repeats                             Int          @default(1)
  osInfo                              String?      @map("os_info")
  browserInfo                         String?      @map("browser_info")
  ipAddress                           String?      @map("ip_address")
  userAgent                           String?      @map("user_agent")
  // Sprint 8 — fleet map view. Optional geo + visual identification so
  // a 100-screen district can manage the fleet on a map instead of a
  // flat list. Address geocoded via Nominatim on save.
  address                             String?
  latitude                            Float?
  longitude                           Float?
  photoUrl                            String?      @map("photo_url")
  // Sprint 8b — indoor positioning. Operator drops the screen pin on
  // a FloorPlan; floorX / floorY are px coords on the plan image.
  // All three nullable because most screens won't be placed on a plan
  // until the customer uploads one.
  floorPlanId                         String?      @map("floor_plan_id")
  floorX                              Float?       @map("floor_x")
  floorY                              Float?       @map("floor_y")
  floorPlan                           FloorPlan?   @relation("ScreensOnFloorPlan", fields: [floorPlanId], references: [id])
  // Menu-mgmt-at-scale (2026-05-29) — which POS-provider location this
  // screen's menu board resolves from. Null = fall back to the screen's
  // own (location) tenant when resolving the menu. Set by the operator
  // when they assign a screen to a store. Device-authed GET
  // /screens/:id/menu reads this to pick the right per-location prices.
  posLocationId                       String?      @map("pos_location_id")
  posLocation                         PosLocation? @relation(fields: [posLocationId], references: [id], onDelete: SetNull)
  // ── Display-control capability verdict (2026-08-13) ──────────────────
  // Last report from the player's read-only DisplayCapabilityProbe
  // (apps/player/.../display/DisplayCapabilityProbe.kt). JSON shape is the
  // probe's own `verdict` block plus a `build` identity echo:
  //   { schema, probedAt, reportedAt,
  //     build: { manufacturer, model, board, sdk, … },
  //     verdict: { volume: 'audiomanager'|'none',
  //                brightness: 'sysfs'|'settings'|'software-dim',
  //                screenBlank: 'device-owner'|'device-admin'|'none',
  //                reboot: 'device-owner'|'none',
  //                hardPowerOff: 'serial-candidate'|'none',
  //                deviceOwnerPath: 'held'|'blocked-other-owner'
  //                                 |'provisionable-after-factory-reset' } }
  //
  // THIS IS THE TRUTH-GATE for the dashboard's per-screen display panel:
  // the UI renders only the controls this verdict says the hardware can
  // actually perform, and POST /screens/:id/display-control 409s on anything
  // it does not support. Null = never reported (older APK / not yet probed)
  // → every control is disabled, nothing is guessed.
  //
  // NOT manifest-rendered ON PURPOSE, and BOTH columns are listed in
  // SCREEN_TELEMETRY_ONLY_FIELDS (manifest-hot-cache.ts): a capability
  // report must never invalidate a screen's cached manifest. Vendor-recipe
  // selection happens ON THE DEVICE against its own Build.* identity (the
  // recipe `match` block), precisely so the manifest stays independent of
  // this column and identical across the fleet.
  displayCapabilities                 Json?        @map("display_capabilities")
  displayCapabilitiesAt               DateTime?    @map("display_capabilities_at")
  // Last offline-cache status the player reported. JSON shape:
  //   { playlist: { count, bytes }, emergency: { count, bytes } }
  // Lets admins verify each screen actually has emergency assets on disk
  // without trusting the network at the moment of an emergency.
  lastCacheReport                     Json?        @map("last_cache_report")
  lastCacheReportAt                   DateTime?    @map("last_cache_report_at")
  // ── Render-proof heartbeat (2026-05-29) ──────────────────────────────
  // The #1 player-reliability gap: a frozen kiosk still answers TCP reads
  // (lastPingAt stays fresh, status stays ONLINE) while it's actually
  // showing a stuck/black frame. lastPingAt proves "TCP-reachable + JS
  // event loop alive" — it does NOT prove "pixels are painting." These
  // three columns are the proof-of-display signal that DOES.
  //
  // The player advances a requestAnimationFrame-driven paint counter that
  // ONLY increments when the browser/WebView actually composites a frame
  // (rAF callbacks are suppressed when the renderer is frozen, the tab is
  // hidden, or the compositor is wedged). It POSTs the counter + a content
  // signature to /screens/:id/render-proof every ~30s WHILE rendering
  // content. The fleet-status endpoint then flags a screen as render-stale
  // (degraded/RED) when lastRenderedAt is stale EVEN IF lastPingAt is fresh.
  //
  // Purely additive: every column is nullable, defaults to null on every
  // already-paired screen, and NOTHING about lastPingAt / status /
  // emergency / manifest behavior changes. A null lastRenderedAt simply
  // reads as "render-proof unknown" (renderHealth UNKNOWN) — never as RED,
  // so older player builds that don't yet POST render-proof are not falsely
  // alarmed. Also feeds incident replay (V2 B-2 proof+replay): lastRenderedHash
  // is what the screen last actually painted.
  //   lastRenderedAt     — server clock when the most recent render-proof POST landed
  //   lastRenderedFrames — monotonic painted-frame counter the player reported (forensics / liveness delta)
  //   lastRenderedHash   — short signature of the content that was on screen at that paint (proof-of-display)
  lastRenderedAt                      DateTime?    @map("last_rendered_at")
  lastRenderedFrames                  Int?         @map("last_rendered_frames")
  lastRenderedHash                    String?      @map("last_rendered_hash")
  // ── Frame-locked sync (2026-07-28) ───────────────────────────────────
  // syncOffsetMs — per-screen latency trim (±ms). Different display models
  // add different FIXED pipeline latencies (LED controller scaling, TV
  // frame interpolation); the operator nudges this like an AVR's audio-
  // sync setting until side-by-side screens align. Null = 0.
  // lastSyncReport — telemetry from the player while sync mode is active:
  //   { errMs, clockUncertaintyMs, rttMs, locked, contentSig, at }
  // (same nullable-Json pattern as lastCacheReport). Feeds the dashboard
  // "IN SYNC ±Xms" badge. All nullable/additive — no behavior change for
  // screens that never sync. docs/research/2026-07-28-multiscreen-sync/
  syncOffsetMs                        Int?         @map("sync_offset_ms")
  lastSyncReport                      Json?        @map("last_sync_report")
  lastSyncReportAt                    DateTime?    @map("last_sync_report_at")
  // Push-channel health (2026-07-31 poll-only-dongle incident): stamped by
  // the WS gateway (AUTH_OK + heartbeat, debounced) and the SSE service
  // (connect + keepalive tick). Fresh (<10 min) = realtime push is LIVE for
  // this screen; stale/null = the screen lives on the HTTP polling backstop
  // and push commands (refresh-web, instant all-clear) will not reach it.
  // Telemetry-only: listed in SCREEN_TELEMETRY_ONLY_FIELDS so writes never
  // thrash the manifest hot cache.
  lastPushConnectedAt                 DateTime?    @map("last_push_connected_at")
  // ── Device-credential revocation (2026-08-03, DT-01/DT-02) ───────────
  // Device JWTs live up to 180 days and there was previously NO way to
  // revoke one: `status='REVOKED'` was read in 8 places and written in
  // zero, and `jwt_revoked_list` (a) has no device writer and (b) carries
  // a 30-day Redis TTL that is shorter than the token it would need to
  // outlive. Deleting the Screen row was the only kill switch, and it
  // destroyed the screen's schedules and history with it.
  //
  // credentialEpoch is the authoritative revocation store: a monotonic
  // counter on the screen row itself. Every minted device token carries
  // an `ep` claim; every device-authenticated request compares the claim
  // against this column and refuses on mismatch. Because it lives in
  // Postgres it has NO TTL, survives a total Redis outage, and outlives
  // the token by construction.
  //
  // GRANDFATHERING: tokens minted before this column existed carry no
  // `ep` claim and are read as epoch 0 — which is this column's default —
  // so the entire deployed fleet keeps authenticating unchanged. The
  // first bump (unpair / re-pair to a new tenant / explicit revoke /
  // rotation on next register) is what retires them.
  credentialEpoch                     Int          @default(0) @map("credential_epoch")
  // When credentialEpoch last moved. Renewal accepts the immediately
  // PREVIOUS epoch for CREDENTIAL_EPOCH_GRACE_MS after this stamp so a
  // lost/retried register response (or two register calls racing on boot)
  // can never lock a legitimate kiosk out of its own credential.
  credentialEpochRotatedAt            DateTime?    @map("credential_epoch_rotated_at")
  // Set alongside status='REVOKED' by the operator "Revoke credential"
  // action. Purely forensic — the enforcement is status + credentialEpoch.
  credentialRevokedAt                 DateTime?    @map("credential_revoked_at")
  // Android APK self-reported version. The player OTA worker already
  // POSTs versionName + versionCode to /player/update-check every 6h
  // and on boot; we just persist the two strings so admins can see at
  // a glance on /screens which kiosks are still on the old build.
  // Both nullable — browser players (no APK) never set them.
  playerVersion                       String?      @map("player_version") // "1.0.8"
  playerVersionCode                   Int?         @map("player_version_code") // 8
  playerVersionAt                     DateTime?    @map("player_version_at") // last poll that reported it
  // Manual-push opt-in for OTA. When the admin clicks "Push update"
  // on a specific screen we set this to now(); the next call this
  // screen makes to /player/update-check returns the latest APK
  // (gating-window: 30 min). After that window the field is just
  // history. When tenant.autoUpdatePlayerEnabled = true this field
  // is irrelevant — auto-mode always returns the latest.
  forceApkUpdatePendingAt             DateTime?    @map("force_apk_update_pending_at")
  // Bypass the tenant's OTA maintenance window for this specific push.
  // Admin checks "Apply now (override window)" on the dashboard's Push
  // Update dialog — emergency hotfixes that can't wait for 2 AM.
  // Cleared automatically alongside forceApkUpdatePendingAt when the
  // install completes (versionCode bump observed in heartbeat).
  forceApkUpdateOverrideWindow        Boolean      @default(false) @map("force_apk_update_override_window")
  // v1.0.12 — per-phase OTA progress reported by OtaUpdateWorker.
  // Lets the dashboard show a real progress bar grounded in device
  // truth instead of the time-based theater that was killing trust.
  // States: CHECKING | DOWNLOADING | VERIFYING | INSTALLING | INSTALLED | ERROR
  // Progress: 0-100 (only meaningful during DOWNLOADING).
  lastOtaState                        String?      @map("last_ota_state")
  lastOtaProgress                     Int?         @map("last_ota_progress")
  lastOtaMessage                      String?      @map("last_ota_message")
  lastOtaAt                           DateTime?    @map("last_ota_at")
  // ── Sticky OTA failure signal (2026-08-03, OTA-02) ───────────────────
  // `lastOtaState` is last-writer-wins, so the canary auto-promote gate
  // that read it was self-erasing: the player reports CHECKING at the
  // head of EVERY OTA cycle, which overwrote a genuine ERROR long before
  // the 24h soak expired — and an anonymous caller could overwrite it
  // deliberately. These two columns are the gate's real input: once an
  // ERROR is recorded it STAYS recorded until the install actually lands
  // (a confirmed versionCode bump) or an operator re-pushes / re-arms the
  // canary. No non-ERROR state report can clear them.
  lastOtaErrorAt                      DateTime?    @map("last_ota_error_at")
  lastOtaErrorMessage                 String?      @map("last_ota_error_message")
  // True when the ERROR above arrived on a device-authenticated request.
  // An authenticated failure always halts promotion; unauthenticated ones
  // are subject to the cohort error-rate threshold (outlier rejection),
  // so a single forged ERROR can no longer hold a fleet's patch pipeline
  // closed forever.
  lastOtaErrorAuthenticated           Boolean      @default(false) @map("last_ota_error_authenticated")
  // Phase 2 — last crash from Player or Manager. Captured by an
  // UncaughtExceptionHandler in each APK and POSTed to
  // /api/v1/screens/status/:fp/crash-report. Source = "player" |
  // "manager" so dashboards can attribute. Stack is truncated at
  // ~8KB on the API side (large enough for a full Kotlin stack
  // trace, small enough to not blow up our row size).
  lastCrashAt                         DateTime?    @map("last_crash_at")
  lastCrashVersion                    String?      @map("last_crash_version")
  lastCrashSource                     String?      @map("last_crash_source")
  lastCrashMessage                    String?      @map("last_crash_message")
  lastCrashStack                      String?      @map("last_crash_stack")
  // v1.0.13 — Manager APK version (companion to Player). Reported
  // by Player's heartbeat which queries Manager via PackageManager
  // (Manager itself doesn't heartbeat — keeps the Manager codebase
  // small and avoids two network connections per kiosk).
  managerVersion                      String?      @map("manager_version")
  managerVersionAt                    DateTime?    @map("manager_version_at")
  // Sprint 8b operator-config layer for the 6 emergency types (LOCKDOWN /
  // EVACUATE / WEATHER / HOLD / SECURE / MEDICAL).
  // For each type the operator can:
  //   1. Leave it null         → screen falls back to Tenant.panic*PlaylistId
  //   2. Set a playlist id     → screen uses THAT playlist when this type fires
  //   3. Set a textBlob (todo) → screen renders that text on a default emergency template
  // The manifest endpoint reads these per-screen overrides BEFORE the
  // tenant defaults; that's how "different content per room" works
  // without coupling per-screen overrides to a manual trigger event.
  // Schema is purely additive; existing screens default everything to
  // null = "use tenant settings."
  emergencyLockdownPlaylistId         String?      @map("emergency_lockdown_playlist_id")
  emergencyEvacuatePlaylistId         String?      @map("emergency_evacuate_playlist_id")
  emergencyWeatherPlaylistId          String?      @map("emergency_weather_playlist_id")
  emergencyHoldPlaylistId             String?      @map("emergency_hold_playlist_id")
  emergencySecurePlaylistId           String?      @map("emergency_secure_playlist_id")
  emergencyMedicalPlaylistId          String?      @map("emergency_medical_playlist_id")
  // Per-screen custom emergency asset URLs (image / video / PDF). When
  // set, the player renders this single asset full-screen during that
  // emergency type. Resolution priority in the manifest endpoint:
  //   1. emergency*PlaylistId  (explicit playlist for this type)
  //   2. emergency*AssetUrl    (single uploaded asset for this type)
  //   3. Tenant.panic*PlaylistId (school-wide default)
  // Lets operators upload a "lockdown — hold position" image for the
  // gym wing without needing to first wrap it in a one-item playlist.
  emergencyLockdownAssetUrl           String?      @map("emergency_lockdown_asset_url")
  emergencyEvacuateAssetUrl           String?      @map("emergency_evacuate_asset_url")
  emergencyWeatherAssetUrl            String?      @map("emergency_weather_asset_url")
  emergencyHoldAssetUrl               String?      @map("emergency_hold_asset_url")
  emergencySecureAssetUrl             String?      @map("emergency_secure_asset_url")
  emergencyMedicalAssetUrl            String?      @map("emergency_medical_asset_url")
  // Portrait variants — same 6 types again. The screen's resolution
  // determines which set the manifest reads from. Operator can upload
  // a horizontal "lockdown — hold position" poster AND a vertical
  // poster designed for portrait kiosks; the player picks the right
  // one based on its physical orientation, same way the tenant-wide
  // panic*Portrait*PlaylistId already does.
  emergencyLockdownPortraitPlaylistId String?      @map("emergency_lockdown_portrait_playlist_id")
  emergencyEvacuatePortraitPlaylistId String?      @map("emergency_evacuate_portrait_playlist_id")
  emergencyWeatherPortraitPlaylistId  String?      @map("emergency_weather_portrait_playlist_id")
  emergencyHoldPortraitPlaylistId     String?      @map("emergency_hold_portrait_playlist_id")
  emergencySecurePortraitPlaylistId   String?      @map("emergency_secure_portrait_playlist_id")
  emergencyMedicalPortraitPlaylistId  String?      @map("emergency_medical_portrait_playlist_id")
  emergencyLockdownPortraitAssetUrl   String?      @map("emergency_lockdown_portrait_asset_url")
  emergencyEvacuatePortraitAssetUrl   String?      @map("emergency_evacuate_portrait_asset_url")
  emergencyWeatherPortraitAssetUrl    String?      @map("emergency_weather_portrait_asset_url")
  emergencyHoldPortraitAssetUrl       String?      @map("emergency_hold_portrait_asset_url")
  emergencySecurePortraitAssetUrl     String?      @map("emergency_secure_portrait_asset_url")
  emergencyMedicalPortraitAssetUrl    String?      @map("emergency_medical_portrait_asset_url")
  // 2026-05-27 — player-hardware identification. One of the literals in
  // packages/api-types/src/hardware-models.ts HardwareModel union:
  //   goodview-ep6n | goodview-ecbox3576 | novastar-taurus | pi5 |
  //   generic-android | web | unknown
  // Null on every screen paired before the column was added; the dashboard
  // resolves null → 'unknown' which suppresses capability chips and
  // hardware-gated UI panels. Operator picks the value from the
  // Diagnostics drawer dropdown. Plain string column (not a Postgres enum)
  // so adding a new model is purely additive — no migration required for
  // future SKUs. Validation lives in the API + UI layers against the
  // shared HARDWARE_CATALOG.
  hardwareModel                       String?      @map("hardware_model")
  // VenueOS Sports — Sprint 13 Phase 3. When set, this screen shows
  // the live scoreboard for that Game instead of its scheduled
  // playlist. Plain nullable column (no FK) — the manifest endpoint
  // ignores a stale id gracefully and deleteGame() clears it. The
  // emergency takeover always wins: the manifest's emergency branch
  // runs and returns BEFORE the scoreboard branch is ever reached.
  activeBoardGameId                   String?      @map("active_board_game_id")
  // Which sports surface this screen shows for activeBoardGameId:
  // BOARD (full scoreboard) | RIBBON (LED ribbon strip) | SCOREBUG
  // (broadcast overlay). Null is treated as BOARD for back-compat
  // with screens pushed before the surface picker shipped.
  activeBoardSurface                  String?      @map("active_board_surface")
  // 2026-05-27 — Goodview EP6N I/O wiring + state, plus future
  // hardware-specific config. Same pattern as Game.stats (open-shape
  // JSON, validated at the API allow-list rather than via per-key
  // schema columns). Two commits land into this one field:
  //   - Agent B (8ac813b) — wiring sub-object (serial + RS485 + GPIO
  //     mappings). Operator-set in the dashboard's WiringPanel.
  //   - Agent C (df71ef6) — gpioState sub-object (live OUT pin state).
  //     Server-driven; flips automatically on emergency triggers.
  //
  // Documented top-level keys:
  //   wiring = {
  //     rs232_1: 'cts' | 'streamdeck' | 'aux' | 'off',
  //     rs232_2: 'cts' | 'streamdeck' | 'aux' | 'off',
  //     rs485:   'daktronics' | 'nevco' | 'off',
  //     gpio_in:  { in1: 'fire_alarm'|'panic_button'|'door_sensor'|'off',
  //                 in2: same },
  //     gpio_out: { out1: 'status_lamp'|'horn'|'door_strike'|'off',
  //                 out2: same },
  //   }
  //
  //   gpioState = {
  //     out1: 'low' | 'high',
  //     out2: 'low' | 'high',
  //     updatedAt: ISO8601,
  //   }
  //
  // The manifest endpoint surfaces `wiring` (so the player's CtsBridge
  // can route the right native serial port to the right protocol
  // parser) AND `gpioState` as `gpio: { out1, out2 }` (so the player
  // applies output state). The EP6N's Phoenix terminal has 2 RS232 +
  // 1 RS485 + 2 GPIO IN + 2 GPIO OUT. Every other hardware model
  // ignores fields it doesn't have — single-port boxes read only
  // wiring.rs232_1; no-GPIO boxes ignore gpio_in/out entirely. The
  // dashboard's WiringPanel (visible only when
  // `hardwareModel === 'goodview-ep6n'`) writes this via the existing
  // PUT /screens/:id endpoint's relaxed `config` allow-list.
  config                              Json?
  schedules                           Schedule[]
  displaySchedules                    DisplaySchedule[]
  screenGroup                         ScreenGroup? @relation(fields: [screenGroupId], references: [id])
  tenant                              Tenant?      @relation(fields: [tenantId], references: [id])

  // Hot-path queries driving these indexes (all added 2026-04-23 after
  // customer-readiness audit flagged sequential scans at scale):
  //   - GET /screens           → where: { tenantId } order by lastPingAt
  //   - GET /screens/map       → where: { tenantId, status }
  //   - Manifest + status      → derive ONLINE from lastPingAt recency
  @@index([tenantId, status])
  @@index([tenantId, lastPingAt])
  @@index([screenGroupId])
  @@map("screens")
}

model AssetFolder {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  parentId  String?       @map("parent_id")
  name      String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  parent    AssetFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  AssetFolder[] @relation("FolderHierarchy")
  assets    Asset[]

  @@map("asset_folders")
}

model Asset {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  uploadedByUserId String         @map("uploaded_by_user_id")
  folderId         String?        @map("folder_id")
  fileUrl          String         @map("file_url")
  mimeType         String         @map("mime_type")
  status           String         @default("PENDING_APPROVAL")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  fileSize         Int?           @map("file_size")
  originalName     String?        @map("original_name")
  fileHash         String?        @map("file_hash") // SHA-256 hex, computed at upload time for offline-cache integrity
  // Audit P0-5 (2026-05-27): forensic + ops metadata captured when the
  // upload-time image optimizer runs. Shape:
  //   {
  //     originalSize: number,
  //     processedSize: number,
  //     originalDimensions?: { w: number, h: number },
  //     processedDimensions?: { w: number, h: number },
  //     transcodedAt: ISO8601 string,
  //     skippedReason?: string  // when the optimizer left the file alone
  //   }
  // Nullable + additive — every existing row stays untouched. Read it
  // (rarely) to diagnose "why is this asset 4 MB?" or to drive a future
  // "X GB of images saved this month" dashboard tile.
  processingMeta   Json?          @map("processing_meta")
  // AI-generated (or operator-edited) image description. Populated
  // asynchronously after a successful image upload: assets.controller
  // kicks off AiAltTextService.generateImageAltText in the background
  // and persists the returned text here, capped at 160 chars (WCAG /
  // screen-reader best practice is ≤125; the column gives headroom for
  // longer operator overrides without a second migration).
  //
  // Population is fire-and-forget — a failed AI call leaves this NULL
  // and the upload still succeeds. Operators can manually trigger a
  // re-generation via POST /api/v1/assets/:id/generate-alt-text, or
  // edit the field by hand in the asset detail panel.
  //
  // Surfaces consuming this field: WidgetRenderer's <img alt=…>
  // emission, the asset library's accessibility audit, future SEO /
  // search index. Nullable + additive — every existing row stays NULL.
  altText          String?        @map("alt_text") @db.VarChar(160)
  uploadedBy       User           @relation(fields: [uploadedByUserId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  folder           AssetFolder?   @relation(fields: [folderId], references: [id])
  playlistItems    PlaylistItem[]

  // Hot-path:
  //   - GET /assets            → where: { tenantId } order by createdAt
  //   - GET /assets/pending    → where: { tenantId, status } order by createdAt
  //   - Folder view            → where: { tenantId, folderId }
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, folderId])
  @@map("assets")
}

model Playlist {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  name             String
  templateId       String?        @map("template_id")
  // Set on a playlist COPY distributed from a parent (corporate) playlist down
  // to a child location. Enables idempotent re-publish (update the existing
  // copy instead of duplicating) + a "from HQ" badge. Null on originals.
  sourcePlaylistId String?        @map("source_playlist_id")
  createdByUserId  String?        @map("created_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  // Protected playlists are owned by the system (e.g. emergency content
  // bound to Tenant.panicLockdownPlaylistId). They are hidden from the
  // /playlists list and cannot be deleted by an admin — preventing the
  // "I accidentally deleted the lockdown playlist mid-emergency" failure
  // mode. Created automatically by the panic-content endpoints and
  // managed only through that surface.
  isProtected      Boolean        @default(false) @map("is_protected")
  protectedKind    String?        @map("protected_kind") // 'lockdown' | 'weather' | 'evacuate' | null
  items            PlaylistItem[]
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  template         Template?      @relation(fields: [templateId], references: [id])
  createdBy        User?          @relation("PlaylistCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  schedules        Schedule[]

  @@index([tenantId, isProtected])
  @@index([tenantId, updatedAt])
  @@index([tenantId, createdAt])
  @@index([createdByUserId])
  @@index([tenantId, sourcePlaylistId])
  @@map("playlists")
}

model PlaylistItem {
  id             String   @id @default(uuid())
  playlistId     String   @map("playlist_id")
  assetId        String   @map("asset_id")
  durationMs     Int      @map("duration_ms")
  sequenceOrder  Int      @map("sequence_order")
  daysOfWeek     String?  @map("days_of_week")
  timeStart      String?  @map("time_start")
  timeEnd        String?  @map("time_end")
  transitionType String?  @default("FADE") @map("transition_type")
  // 2026-05-05 — operator: "i noticed when i published videos the
  // sound didnt play, that should be an option when i am adding the
  // video to the playlist if i want to mute playback or not".
  // Per-item override of the player's <video muted> attribute.
  // Default true preserves the previous always-muted behavior; the
  // editor exposes a "Play with sound" toggle on video items only.
  // The Android Player's WebView already has
  // mediaPlaybackRequiresUserGesture=false so unmuted autoplay does
  // work on the kiosk.
  muted          Boolean  @default(true)
  asset          Asset    @relation(fields: [assetId], references: [id])
  playlist       Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  // Manifest endpoint fetches playlist items by playlistId in sequence
  // order on every player poll — this is the most-read query in the app.
  @@index([playlistId, sequenceOrder])
  @@map("playlist_items")
}

model Schedule {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  playlistId    String       @map("playlist_id")
  screenGroupId String?      @map("screen_group_id")
  screenId      String?      @map("screen_id")
  startTime     DateTime     @map("start_time")
  endTime       DateTime?    @map("end_time")
  daysOfWeek    String?      @map("days_of_week")
  timeStart     String?      @map("time_start")
  timeEnd       String?      @map("time_end")
  priority      Int          @default(0)
  mode          String       @default("replace") @map("mode")
  // 2026-05-05 — per-publish audio override. When non-null, the
  // manifest resolver forces every video item under this schedule to
  // (mutedOverride=true → muted) or (false → unmuted) regardless of
  // the per-PlaylistItem.muted setting. Lets the operator publish the
  // SAME playlist to the lobby muted and the cafeteria unmuted
  // without rewriting per-item flags. Null = honor per-item setting.
  mutedOverride Boolean?     @map("muted_override")
  isActive      Boolean      @default(true) @map("is_active")
  screen        Screen?      @relation(fields: [screenId], references: [id])
  screenGroup   ScreenGroup? @relation(fields: [screenGroupId], references: [id])
  playlist      Playlist     @relation(fields: [playlistId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id])

  // Hot-path — manifest resolver filters schedules by tenant + active +
  // time range to decide which playlist a screen should be playing
  // right now.
  @@index([tenantId, isActive, startTime])
  @@index([screenId])
  @@index([screenGroupId])
  @@index([playlistId])
  @@map("schedules")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  /// ACC-06 follow-up (2026-08-03) — WHICH MACHINE CREDENTIAL DID THIS.
  ///
  /// An action driven by a tenant API key has no `userId` (there is no human
  /// principal), so before this column every such row was forensically
  /// ANONYMOUS: the only way to answer "which key deleted that playlist?"
  /// was to correlate the anonymous row against a separate
  /// `API_KEY_REQUEST` row by (tenantId, timestamp) — an inference, not a
  /// fact, and one that breaks under concurrency. The guard now stamps the
  /// key id directly on the rows it writes, and `auditActorFields()`
  /// (apps/api/src/audit/audit-actor.ts) is the one-liner any other writer
  /// uses to do the same.
  ///
  /// Deliberately a PLAIN column with NO foreign key to TenantApiKey.
  /// `TenantApiKey` cascade-deletes with its Tenant; a FK here would make
  /// that cascade attempt a DELETE/SET NULL against `audit_logs`, which the
  /// §16 append-only trigger blocks — turning an unrelated cleanup into a
  /// hard failure. Same reason `TenantApiKey.createdByUserId` is a bare
  /// String. Key rows are soft-revoked, never deleted, so the id stays
  /// resolvable.
  apiKeyId   String?  @map("api_key_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  // /audit page + /audit/export sort by createdAt desc per tenant.
  // Without this index that's a sequential scan over every tenant's
  // rows — 100-school district hitting the page ran for multiple
  // seconds post-pilot.
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  // "Everything key X ever did", newest first — the incident-response query
  // after a key leaks. Without it that is a full scan of the tenant's
  // history; audit_logs is one of the largest tables in the product.
  @@index([tenantId, apiKeyId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  kind      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  dedupeKey String?  @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, userId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model Template {
  id             String          @id @default(uuid())
  tenantId       String?         @map("tenant_id")
  name           String
  description    String?
  category       String          @default("CUSTOM")
  orientation    String          @default("LANDSCAPE")
  // Filter chip on /templates — 'ELEMENTARY' | 'MIDDLE' | 'HIGH' | 'UNIVERSAL'.
  // Stored as a free string so we don't need a DB enum migration each time
  // a new level (PRE_K, ADULT_ED, etc.) comes along. Defaults to UNIVERSAL
  // so existing templates stay visible under every filter.
  schoolLevel    String          @default("UNIVERSAL") @map("school_level")
  // Industry vertical — gates which templates appear in a tenant's
  // gallery. System templates are tagged with the vertical they were
  // designed for; the /templates list endpoint filters by the
  // requesting tenant's `Tenant.vertical` so a gym never sees EDU
  // templates and vice versa. Custom tenant templates inherit the
  // tenant's own vertical. Defaults K12 because that's the original
  // product + the vast majority of pre-existing rows.
  vertical       String          @default("K12") @map("vertical") // K12 | GYM | RETAIL | CORPORATE | QSR | FASHION | BAR | HEALTHCARE | HOSPITALITY | RESTAURANT | SPORTS — canonical list: packages/api-types/src/verticals.ts (VERTICALS)
  screenWidth    Int             @default(1920) @map("screen_width")
  screenHeight   Int             @default(1080) @map("screen_height")
  isSystem       Boolean         @default(false) @map("is_system")
  status         String          @default("ACTIVE")
  bgColor        String?         @map("bg_color")
  bgImage        String?         @map("bg_image")
  bgGradient     String?         @map("bg_gradient")
  thumbnail      String?
  // Per-template Brand Kit. Distinct from the tenant-wide
  // `TenantBranding` row that themes the CMS dashboard chrome.
  // Operators paste a school URL in the template builder's Brand
  // tab → we scrape colors/logo/fonts and persist them here so the
  // template canvas exposes them as design tokens (palette swatches
  // in the inspector, logo auto-pinned at the top of the asset list,
  // brand fonts at the top of the font picker). Bug fix: until this
  // column existed, the builder's "Detect brand" button wrote to
  // `TenantBranding` and silently re-skinned the entire CMS
  // dashboard — which was never the intent.
  //
  // JSON shape:
  //   {
  //     palette: { primary, primaryHover, accent, ink, surface, surfaceAlt },
  //     logoUrl: string | null,
  //     logoSvgInline: string | null,
  //     fontHeading: string | null,
  //     fontBody: string | null,
  //     displayName: string | null,
  //     sourceUrl: string | null,
  //     scrapedAt: ISO date string,
  //   }
  brandKit       Json?           @map("brand_kit")
  createdById    String?         @map("created_by_id")
  isTouchEnabled Boolean         @default(false) @map("is_touch_enabled")
  idleResetMs    Int             @default(60000) @map("idle_reset_ms")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  zones          TemplateZone[]
  // 2026-05-12 — Phase D2 multi-scene relation. One template can
  // have many scenes (Figma-style frames). Scenes are populated by
  // the migration for every existing template (each gets a single
  // "Default" scene + all current zones repointed to it).
  scenes         TemplateScene[]
  playlists      Playlist[]
  createdBy      User?           @relation("TemplateCreator", fields: [createdById], references: [id])
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])

  // 2026-05-19 — Sprint 13 scoreboard builder. A template can be the
  // scoreboard / ribbon / scorebug for any number of Games (the FK
  // lives on Game). Three back-relations so Prisma can produce typed
  // queries from either side without ambiguity.
  scoreboardGames Game[] @relation("GameScoreboardTemplate")
  ribbonGames     Game[] @relation("GameRibbonTemplate")
  scorebugGames   Game[] @relation("GameScorebugTemplate")

  // Wave C / editor-crush C3 (2026-07-02) — last-5 version history.
  // See TemplateVersion below; onDelete: Cascade so deleting a template
  // doesn't leave orphaned snapshot rows behind.
  versions        TemplateVersion[]

  // Gallery orders by (isSystem desc, updatedAt desc) filtered by
  // tenantId + status + vertical. Composite index covers the common
  // combinations.
  @@index([tenantId, status])
  @@index([isSystem, status, vertical, updatedAt])
  @@map("templates")
}

// Wave C / editor-crush C3 (2026-07-02) — "even last-5 snapshots kills
// the 'one bad Save is unrecoverable' class" (06-CRUSH-CANVA-PLAN.md).
// A compact snapshot written on every successful Save (metadata PUT +
// zones replace-all PUT both land in the same logical save from the
// builder, so the controller writes ONE version row per save covering
// both). Only the newest 5 rows per template are kept — older ones are
// deleted in the same transaction as the insert (see
// TemplatesController.snapshotVersion). Restoring a version does NOT
// overwrite destructively: POST .../versions/:versionId/restore itself
// snapshots the CURRENT state first (so a bad restore is itself
// recoverable), then applies the old zones/meta as a normal save.
//
// Deliberately NOT storing a `name`/`label` — this is a lightweight
// last-5 safety net, not a full named-version feature (that's a much
// bigger UI + retention-policy decision left for later).
model TemplateVersion {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  tenantId   String   @map("tenant_id")
  // Nullable — a version could in principle be written by a system
  // process (none exist today, but don't force a fake user id if one
  // ever does), and SetNull on the user relation must not cascade into
  // losing the whole snapshot when a user account is deleted.
  byUserId   String?  @map("by_user_id")
  // Full zones[] array (same shape TemplateReplaceZonesSchema accepts)
  // at the moment of this save.
  zones      Json
  // The subset of Template scalar fields the builder actually edits
  // (name/description/screenWidth/screenHeight/bgColor/bgGradient/
  // bgImage/isTouchEnabled/idleResetMs) — NOT the whole Template row,
  // so this never drifts if unrelated columns (category, vertical,
  // brandKit, …) change out from under a stale version.
  meta       Json
  createdAt  DateTime @default(now()) @map("created_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  byUser   User?    @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  // The History panel lists "the 5 most recent for this template" —
  // exactly this access pattern. Also index tenantId alone so a
  // tenant-wide cleanup/export job never needs a sequential scan.
  @@index([templateId, createdAt])
  @@index([tenantId])
  @@map("template_versions")
}

model EmergencyMessage {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  triggeredByUserId String?   @map("triggered_by_user_id")
  type              String
  severity          String    @default("CRITICAL")
  textBlob          String?   @map("text_blob")
  mediaUrls         String?   @map("media_urls")
  audioUrl          String?   @map("audio_url")
  scopeType         String    @map("scope_type")
  scopeId           String    @map("scope_id")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  clearedAt         DateTime? @map("cleared_at")
  clearedByUserId   String?   @map("cleared_by_user_id")

  @@index([tenantId, createdAt(sort: Desc)], map: "emergency_messages_tenant_created_idx")
  @@map("emergency_messages")
}

model TemplateZone {
  id            String         @id @default(uuid())
  templateId    String         @map("template_id")
  // 2026-05-12 — Phase D2 (touch builder multi-scene). Each zone
  // belongs to ONE scene. Nullable so legacy single-scene templates
  // keep working — the migration backfills every existing zone with
  // its parent template's default scene id, so post-migration this
  // is effectively always set. Stays nullable on the schema to keep
  // future template authoring tools simple.
  sceneId       String?        @map("scene_id")
  name          String
  widgetType    String         @map("widget_type")
  x             Float          @default(0)
  y             Float          @default(0)
  width         Float          @default(100)
  height        Float          @default(100)
  zIndex        Int            @default(0) @map("z_index")
  sortOrder     Int            @default(0) @map("sort_order")
  defaultConfig String?        @map("default_config")
  touchAction   Json?          @map("touch_action")
  template      Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scene         TemplateScene? @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  // Render gates by (templateId, sceneId) on every playback fetch —
  // index supports the hot query path.
  @@index([templateId, sceneId])
  @@map("template_zones")
}

/// Phase D2 (2026-05-12) — touch builder multi-scene model.
///
/// Until D2, a Template was one canvas. A touch flow that needs more
/// than one screen had to span multiple Templates, navigated via
/// goto-template. That worked but split the operator's mental model:
/// "this kiosk shows the Front Desk template, which tap-links to the
/// Check In template, which tap-links to the Visitor Pass template."
/// Three rows in the gallery; one logical flow.
///
/// Multi-scene collapses that: a single Template owns N TemplateScene
/// rows. Each scene has its own zones. Tap actions can target a
/// sceneId within the same template (goto-scene) or another template
/// entirely (goto-template, unchanged).
///
/// One scene per template is marked `isDefault = true`. The player
/// starts there on first render. Operator-deletable scenes can't
/// delete the default — a guard on the controller blocks it.
model TemplateScene {
  id         String         @id @default(uuid())
  templateId String         @map("template_id")
  name       String
  sortOrder  Int            @default(0) @map("sort_order")
  isDefault  Boolean        @default(false) @map("is_default")
  createdAt  DateTime       @default(now()) @map("created_at")
  template   Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  zones      TemplateZone[]

  @@unique([templateId, name])
  @@index([templateId, sortOrder])
  @@map("template_scenes")
}

// Phase D5 (2026-05-12) — tap analytics. Player batches edu:touch-action
// events and ships them here so operators can see WHICH zones are
// actually being tapped vs the ones they THOUGHT visitors would tap.
// Used by the builder's "Tap counts" overlay + the future dashboard
// heatmap widget.
//
// We deliberately do NOT use AuditLog for this:
//   - Audit log is immutable + legally significant for emergency actions
//   - Audit rows are 0.5–2 KB each; tap events are 100 bytes — a small
//     row per tap keeps storage cost predictable
//   - Audit log indices are tuned for "show me everything user X did";
//     analytics need "group taps by zone over a date range" which is
//     a totally different access pattern
//
// Schema is additive. NO foreign keys to Template/TemplateZone — taps
// must survive a template edit/delete (forensics + retention). The
// templateId / zoneId are stored as opaque strings; aggregation joins
// in-memory in the controller.
// Field comments:
//   actionType   — Touch action 'type' field (open-url, goto-scene, ...)
//   actionTarget — Optional target the action resolved to (URL, scene id, asset id)
//   clientTs     — Client-side timestamp from the player; trusted within ±5 min
//   createdAt    — Server-side ingest time; used for retention sweeps
model TouchEvent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  screenId     String?  @map("screen_id")
  templateId   String   @map("template_id")
  zoneId       String?  @map("zone_id")
  sceneId      String?  @map("scene_id")
  actionType   String?  @map("action_type")
  actionTarget String?  @map("action_target")
  clientTs     DateTime @map("client_ts")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  // Hot path: "show me taps for THIS template over the last 30 days"
  @@index([tenantId, templateId, createdAt])
  // Per-zone aggregation: "rank zones by tap count for this template"
  @@index([templateId, zoneId])
  @@map("touch_events")
}

// Proof-of-play analytics — append-only playback samples.
//
// A background sampler (ProofOfPlaySampler) writes one row per online
// screen every ~10 minutes, capturing the playlist effectively
// scheduled to it. The dashboard aggregates these into content /
// sponsor display-time reports ("playlist X was live on N screens for
// M hours"). NO foreign keys — same rationale as Submission: proof-of-
// play is a permanent record that must survive a later playlist /
// screen delete. Purely additive — a new table, no other model touched.
model PlaybackSample {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  screenId   String   @map("screen_id")
  playlistId String   @map("playlist_id")
  sampledAt  DateTime @default(now()) @map("sampled_at")

  // Hot path: the proof-of-play report aggregates inside a per-tenant
  // window → (tenantId, sampledAt) serves every report query. The plain
  // sampledAt index serves the nightly retention purge. The per-column
  // playlistId/screenId indexes were DROPPED 2026-07-20 (efficiency
  // audit): 0–1 scans ever in production while costing 62% of the
  // table's disk footprint — grouping happens inside the tenant window.
  @@index([tenantId, sampledAt])
  @@index([sampledAt])
  @@map("playback_samples")
}

// Sprint 1.5 — submit-for-review workflow.
//
// CONTRIBUTOR creates draft assets/playlists/schedules, bundles them
// into a Submission, picks one or more admins to notify, and sends it
// off. Admins see PENDING submissions on a Reviews page, drill in to
// preview content, then Approve (publish) or Reject (with feedback).
// Audit-logged on every state change. Migration is additive: new
// table only — referenced asset/playlist/schedule ids are stored as
// CSV strings (no foreign keys) so historical submissions remain
// queryable even after their linked content is later edited or
// removed, and the existing tables don't need new columns.
model Submission {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  submittedById String    @map("submitted_by_user_id")
  status        String    @default("PENDING")
  note          String?
  reviewerNote  String?   @map("reviewer_note")
  notifyUserIds String    @default("") @map("notify_user_ids")
  assetIds      String    @default("") @map("asset_ids")
  playlistIds   String    @default("") @map("playlist_ids")
  scheduleIds   String    @default("") @map("schedule_ids")
  createdAt     DateTime  @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")
  decidedById   String?   @map("decided_by_user_id")

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  submittedBy User   @relation("SubmissionsSubmitted", fields: [submittedById], references: [id])
  decidedBy   User?  @relation("SubmissionsDecided", fields: [decidedById], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([submittedById, createdAt])
  @@map("submissions")
}

// ─────────────────────────────────────────────────────────────────
// Sprint 8b — indoor floor plans + per-screen emergency targeting.
// ─────────────────────────────────────────────────────────────────
//
// FloorPlan is the "where in the building" map. Operator uploads a
// PNG/PDF of their architectural floor plan once per floor, stores
// dimensions so screen positions stay consistent, and drops Screen
// pins on it (Screen.floorPlanId + floorX + floorY in pixel coords).
//
// FloorZone is a named polygon drawn on a FloorPlan. Operator labels
// "Wing A", "Cafeteria", "Gym". Used to bulk-target screens for
// emergency triggers via "trigger lockdown on the Gym wing only."
//
// ScreenEmergencyOverride is the per-screen alert. Player checks this
// FIRST — per-screen wins over the tenant-wide Tenant.emergencyStatus.
// That's what makes "different alert per room" work without redesigning
// the existing emergency model.
//
// Schema is purely ADDITIVE (memory: "additive only" for v1 pilot).
// Three new tables + four nullable columns on Screen. No existing
// query patterns change.

model FloorPlan {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  name                  String // "Lincoln HS — Floor 1"
  buildingLabel         String?  @map("building_label") // "Main Building"
  floorLabel            String?  @map("floor_label") // "Floor 1"
  imageUrl              String   @map("image_url") // Supabase-hosted PNG
  widthPx               Int      @map("width_px") // Image dimensions for stable coords
  heightPx              Int      @map("height_px")
  // Optional: which zones on this plan should default to which alert
  // type. Stored as JSON for flexibility. Not used in Phase 1; reserved
  // for the scenario-picker UI in Phase 2.
  defaultScenarioConfig Json?    @map("default_scenario_config")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  zones   FloorZone[]
  screens Screen[]    @relation("ScreensOnFloorPlan")

  @@index([tenantId])
  @@map("floor_plans")
}

model FloorZone {
  id          String   @id @default(uuid())
  floorPlanId String   @map("floor_plan_id")
  name        String // "Wing A", "Gym", "Cafeteria"
  color       String   @default("#6366f1") // Pin color when zone is selected
  // Polygon shape — JSON array of { x, y } px coords on the plan image.
  shape       Json
  createdAt   DateTime @default(now()) @map("created_at")

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  @@index([floorPlanId])
  @@map("floor_zones")
}

// Per-screen emergency override. Player checks this FIRST; if no
// override row exists for the current screen, falls back to the
// tenant-wide Tenant.emergencyStatus. This is what makes Sprint 8b
// "different alert per room" work without breaking the existing
// global-trigger model.
//
// `expiresAt` is the wall-clock time at which the player should
// stop honoring this override. The server's all-clear endpoint
// also clears the row explicitly (deletes or sets active=false).
// `triggeredByUserId` is the operator who fired this scoped alert
// — surfaces in the audit log for forensics.
model ScreenEmergencyOverride {
  id                String    @id @default(uuid())
  screenId          String    @unique @map("screen_id")
  tenantId          String    @map("tenant_id") // Denormalized for audit speed
  type              String // LOCKDOWN | EVACUATE | WEATHER | HOLD | SECURE | MEDICAL | ALL_CLEAR
  severity          String    @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  scopeNote         String?   @map("scope_note") // "Gym wing — hold position"
  // Optional content overrides — null falls back to tenant defaults.
  playlistId        String?   @map("playlist_id")
  textBlob          String?   @map("text_blob")
  mediaUrl          String?   @map("media_url")
  // Floor plan / zone / scenario the operator targeted (for forensics
  // and to show "this came from the Gym lockdown scenario" in audit).
  floorPlanId       String?   @map("floor_plan_id")
  floorZoneId       String?   @map("floor_zone_id")
  scenarioId        String?   @map("scenario_id")
  triggeredByUserId String    @map("triggered_by_user_id")
  triggeredAt       DateTime  @default(now()) @map("triggered_at")
  expiresAt         DateTime? @map("expires_at")

  @@index([tenantId, triggeredAt])
  @@map("screen_emergency_overrides")
}

// ─────────────────────────────────────────────────────────────────────
// Streaming integrations — Sprint 8c (2026-05-03)
// ─────────────────────────────────────────────────────────────────────
//
// Multi-tenant streaming framework: gym/bar/restaurant operators
// connect a streaming provider (Atmosphere, Pluto TV, YouTube, Twitch,
// custom HLS, etc.), enter their auth, pick channels, and the
// digital-signage player streams that content alongside ad rotations.
//
// Three rows:
//   StreamProviderConnection — one row per (tenant, provider). Holds
//     per-tenant auth (encrypted). Tenant-A's Twitch creds never
//     touch Tenant-B. envelope-encrypted with DEVICE_SECRET_KEY.
//   StreamChannel — picked content from a provider. Channels can be
//     live (HLS/DASH/RTMP/iframe), VOD, or curated playlists.
//   StreamAdSlot — per-screen ad rotation that overlays the streaming
//     content (lower-third, side-rail, or full-bleed every N min).
//
// Schema is ADDITIVE — no breaking change to existing models. Every
// FK is optional or scoped to a new table so disabling the feature
// flag (FEATURE_STREAMING) is a no-op.
//
// Why these live in DB (not localStorage):
//   • Credentials need at-rest encryption.
//   • Channels need to fan out to N screens — must be reachable from
//     the player without each screen re-authing.
//   • Ad slots need an audit log (who scheduled what, when).
//
model StreamProviderConnection {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  // Canonical provider id from packages/api-types/src/streaming.ts
  // (e.g. "atmosphere" / "pluto-tv" / "youtube" / "twitch" / "hls").
  providerId       String    @map("provider_id")
  // Display name override (optional) — falls back to provider's default.
  displayName      String?   @map("display_name")
  // Envelope-encrypted credentials blob (JSON). Never stored
  // plaintext. Decryption requires DEVICE_SECRET_KEY at the API layer.
  // Shape varies per provider:
  //   { type: 'oauth', accessToken, refreshToken, expiresAt }
  //   { type: 'apiKey', apiKey, accountId? }
  //   { type: 'license', licenseNumber, accountId, region }
  //   { type: 'none' } — for free FAST channels (Pluto, Tubi)
  encryptedCreds   String    @map("encrypted_creds")
  // KMS-style envelope: per-row data key wrapped by DEVICE_SECRET_KEY.
  // Rotation works by re-wrapping data keys without re-encrypting blobs.
  encryptedDataKey String    @map("encrypted_data_key")
  // Status — set during the OAuth handshake / API-key validation.
  // Player checks this before subscribing to streams; UI badge.
  status           String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | REVOKED | ERROR
  statusReason     String?   @map("status_reason")
  lastVerifiedAt   DateTime? @map("last_verified_at")
  // OAuth refresh metadata (only for OAuth providers).
  expiresAt        DateTime? @map("expires_at")
  scope            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdByUserId  String    @map("created_by_user_id")

  channels StreamChannel[]

  @@unique([tenantId, providerId])
  @@index([tenantId, status])
  @@map("stream_provider_connections")
}

// A picked channel / show / video from a provider. The player's
// stream widget reads these by id. One Tenant can have many channels
// per provider (e.g. ESPN + ESPN2 from Atmosphere).
model StreamChannel {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  connectionId   String    @map("connection_id")
  // Provider-specific channel identity. Atmosphere = channelId, YouTube
  // = videoId / channelId, Twitch = login, HLS = playbackUrl.
  externalId     String    @map("external_id")
  kind           String // LIVE | VOD | PLAYLIST | RADIO
  // Cached display metadata so the picker UI doesn't roundtrip the
  // provider for every render. Refreshed when the channel last played.
  title          String
  description    String?
  thumbnailUrl   String?   @map("thumbnail_url")
  category       String? // SPORTS | NEWS | MUSIC | LIFESTYLE | …
  // Resolved playback URL. For DRM/iframe providers this is empty
  // until the player requests a signed URL via /streaming/play.
  playbackUrl    String?   @map("playback_url")
  // Playback type — drives which renderer the widget uses.
  //   "hls"      → <video> tag with hls.js polyfill
  //   "dash"     → <video> with shaka-player
  //   "iframe"   → <iframe> embed (YouTube, Twitch, Vimeo)
  //   "rtmp"     → flash-style (limited browser support; player only)
  //   "rtsp"     → server-side transcode required (future)
  playbackType   String?   @map("playback_type")
  // Whether this channel allows ad overlays per provider TOS. Some
  // forbid (DIRECTV, Atmosphere prohibits competing ads). Editor uses
  // this to disable the "Add ads" button.
  allowAdOverlay Boolean   @default(true) @map("allow_ad_overlay")
  // Provider-specific config blob (region, audio track, captions, etc.)
  config         String?
  status         String    @default("ACTIVE") // ACTIVE | DISABLED | REMOVED_BY_PROVIDER
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastPlayedAt   DateTime? @map("last_played_at")

  connection StreamProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([tenantId, status])
  @@map("stream_channels")
}

// Ad rotation that overlays / interleaves with a stream channel.
// Lives per-tenant; can target a channel (only show during ESPN), a
// screen group (only the lobby TVs), a daypart (only mornings), etc.
// Media is an Asset (existing model) — uploaded once, scheduled into
// many rotations.
model StreamAdSlot {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  // Asset to display — use existing Asset model (image, video, html).
  assetId         String   @map("asset_id")
  // Optional scoping — null = all channels / all screens / all dayparts.
  channelId       String?  @map("channel_id") // limit to one channel
  screenGroupId   String?  @map("screen_group_id") // limit to one group
  // Targeting / cadence — flexible JSON.
  // { dayparts: [{daysOfWeek:[1..5], start:"6:00 AM", end:"9:00 AM"}],
  //   placement: "lower-third" | "side-rail" | "full-bleed",
  //   intervalMs: 300000,    // every 5 min
  //   durationMs: 8000,      // 8s per show
  //   startDate, endDate, weight }
  config          String // JSON
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdByUserId String   @map("created_by_user_id")

  @@index([tenantId, isActive])
  @@map("stream_ad_slots")
}

// ─────────────────────────────────────────────────────────────────────
// POS integrations — Sprint 8d (2026-05-03)
// ─────────────────────────────────────────────────────────────────────
//
// Franchise menu boards + retail price callouts auto-sync from a
// connected POS. Pull-only: we sync the CATALOG (menu / prices /
// hours), not orders. Operators run their actual POS for orders.
//
// Architecture mirrors StreamProviderConnection: per-tenant auth,
// envelope-encrypted credentials, optional realtime webhook receiver.
//
model PosProviderConnection {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  // Canonical provider id from packages/api-types/src/pos.ts
  // (e.g. "square" / "toast" / "clover" / "stripe-terminal").
  providerId        String    @map("provider_id")
  displayName       String?   @map("display_name")
  // Same envelope-encryption scheme as StreamProviderConnection.
  encryptedCreds    String    @map("encrypted_creds")
  encryptedDataKey  String    @map("encrypted_data_key")
  status            String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | REVOKED | ERROR
  statusReason      String?   @map("status_reason")
  lastSyncedAt      DateTime? @map("last_synced_at")
  lastSyncItemCount Int?      @map("last_sync_item_count")
  // OAuth refresh metadata.
  expiresAt         DateTime? @map("expires_at")
  scope             String?
  // Multi-location operators pick which provider-side location maps
  // to which of our screens. JSON: { 'screenId': 'externalLocationId' }
  locationMap       String?   @map("location_map")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdByUserId   String    @map("created_by_user_id")

  items        PosMenuItem[]
  categories   PosCategory[]
  // Menu-mgmt-at-scale (2026-05-29) — provider-side locations synced
  // under this connection (one per store for a multi-location chain).
  posLocations PosLocation[]

  @@unique([tenantId, providerId])
  @@index([tenantId, status])
  @@map("pos_provider_connections")
}

// One menu item / SKU from a provider's catalog. Synced on a cron
// (default: every 15 min for poll-based; instant for webhook-based).
// Widget renderers (RestaurantMenuBoard, RetailPriceCallout) read
// from these rows directly — no per-render API call.
model PosMenuItem {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  connectionId      String    @map("connection_id")
  externalId        String    @map("external_id")
  name              String
  description       String?
  priceCents        Int       @map("price_cents")
  salePriceCents    Int?      @map("sale_price_cents")
  category          String?
  imageUrl          String?   @map("image_url")
  badges            String[]  @default([])
  available         Boolean   @default(true)
  // Optional location filter — for multi-location chains.
  locationId        String?   @map("location_id")
  // Provider-side last-modified for delta sync.
  externalUpdatedAt DateTime? @map("external_updated_at")
  syncedAt          DateTime  @default(now()) @map("synced_at")

  connection PosProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([tenantId, available])
  @@index([connectionId, category])
  @@map("pos_menu_items")
}

model PosCategory {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  connectionId String   @map("connection_id")
  externalId   String   @map("external_id")
  name         String
  sortOrder    Int      @default(0)
  syncedAt     DateTime @default(now()) @map("synced_at")

  connection PosProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([tenantId])
  @@map("pos_categories")
}

// 2026-05-25 — POS webhook idempotency. Square (and Toast / Clover when
// wired) retry on any 5xx and may re-deliver the same event id. At
// webhook entry we INSERT here first — the unique primary key gives us
// atomic dedup at the DB. A second delivery hits a P2002 unique-
// constraint violation and the handler short-circuits. Mirrors the
// ProcessedStripeEvent table used by the Stripe webhook.
model ProcessedPosEvent {
  // Compound id: `${providerId}:${externalEventId}` — providers reuse
  // event-id namespaces (a Square event_id could collide with a Toast
  // one), so scope by provider before checking dedup.
  id          String   @id
  providerId  String   @map("provider_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@index([providerId])
  @@map("processed_pos_events")
}

// ═════════════════════════════════════════════════════════════════════
// Menu management at scale — design-once catalog + per-location overrides
// (2026-05-29). See docs/research/2026-05-29-menu-mgmt-scale/.
// ═════════════════════════════════════════════════════════════════════
//
// The competitor-converged architecture: a CENTRAL catalog ("design
// once") + per-location price/availability OVERRIDES + POS-webhook 86.
//
//   MenuCatalog        — one "design once" menu owned by a chain tenant.
//   MenuCategory       — section in a catalog (optional daypart binding).
//   MenuItem           — an item with a DEFAULT price; the base everyone
//                        inherits. `externalId` ties it to a Square/Toast
//                        catalog object for sync.
//   MenuLocationOverride — the missing price-book piece. Per (location,
//                        item): a price override (null = inherit default),
//                        an availability/86 flag, a sold-out-until timer,
//                        and a hide flag.
//   PosLocation        — a POS-provider-side location (Square location_id)
//                        mapped to one of our (child) location tenants.
//   Daypart            — we own dayparting (Square has no daypart
//                        primitive); a window of days + local time.
//   MenuSyncCursor     — Square delta-sync watermark per connection.
//
// Resolution rule (resolveMenuForLocation):
//   price   = override.priceCents ?? item.defaultPriceCents
//   visible = !override.isHidden && override.isAvailable
//             && (override.soldOutUntil == null || soldOutUntil < now)
//   active daypart = by the LOCATION's local time.
//
// ALL ADDITIVE — new tables + one nullable Screen column + nullable
// reverse relations on PosProviderConnection. Live-pilot-safe; no
// existing query pattern changes.

// One "design once" menu, owned by a chain/parent tenant. A 50-location
// operator typically has one catalog (or a few — breakfast vs all-day)
// and overrides per location, never 50 separate menus.
model MenuCatalog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  // Optional link to the POS connection this catalog syncs from. Null
  // for hand-built / custom-webhook catalogs that aren't tied to one
  // provider connection.
  connectionId String?  @map("connection_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  categories MenuCategory[]
  items      MenuItem[]

  @@index([tenantId, isActive])
  @@index([connectionId])
  @@map("menu_catalogs")
}

// A section within a catalog ("Burgers", "Breakfast", "On Tap"). May be
// bound to a Daypart so a section only shows in its window (e.g.
// breakfast 6-11am). daypartId null = always shown.
model MenuCategory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  catalogId String   @map("catalog_id")
  name      String
  daypartId String?  @map("daypart_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  catalog MenuCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  daypart Daypart?    @relation(fields: [daypartId], references: [id], onDelete: SetNull)
  items   MenuItem[]

  @@index([catalogId, sortOrder])
  @@index([tenantId])
  @@index([daypartId])
  @@map("menu_categories")
}

// A single menu item with a DEFAULT price that every location inherits
// unless a MenuLocationOverride says otherwise. `externalId` ties it to
// the source POS catalog object (Square `item:variation` id, Toast guid,
// or a custom-webhook id) so a sync can upsert by it.
model MenuItem {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  catalogId         String   @map("catalog_id")
  categoryId        String?  @map("category_id")
  // Provider-side id (Square/Toast/custom). Unique per catalog so a sync
  // upserts the same item in place across runs. Null for purely
  // hand-authored items that never came from a POS.
  externalId        String?  @map("external_id")
  name              String
  description       String?
  // The base price every location inherits absent an override.
  defaultPriceCents Int      @map("default_price_cents")
  imageUrl          String?  @map("image_url")
  // Dietary / allergen chips ("V" / "GF" / "DF" / "contains-nuts").
  allergens         String[] @default([])
  // Free-form merchandising tags ("popular" / "new" / "spicy").
  tags              String[] @default([])
  // Optional size / option price variants, catalog-level (v1). A JSON
  // array of { label: string, priceCents: number } — e.g. Small/Med/Large
  // or "12oz" / "16oz". Null/absent = single-price item. Per-location
  // overrides adjust the base defaultPriceCents only; variant prices are
  // not (yet) location-overridable.
  variants          Json?    @map("variants")
  // Catalog-level availability from the POS (Clover hidden/available:false,
  // Shopify inactive product, Lightspeed archived, Square is_deleted).
  // Providers without per-location data carry availability here; false
  // means the POS says this item must not render anywhere. Per-location
  // 86s stay on MenuLocationOverride.
  isAvailable       Boolean  @default(true) @map("is_available")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  catalog   MenuCatalog            @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  category  MenuCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  overrides MenuLocationOverride[]

  // A POS catalog object maps to exactly one item per catalog.
  @@unique([catalogId, externalId])
  @@index([tenantId])
  @@index([catalogId, sortOrder])
  @@index([categoryId])
  @@index([externalId])
  @@map("menu_items")
}

// The price-book row — per (location, item). This is the missing piece
// the codebase audit called out: per-location pricing + availability.
//   priceCents   null → inherit MenuItem.defaultPriceCents.
//   isAvailable  false → 86'd (out of stock / removed for this location).
//   soldOutUntil set  → temporarily 86'd; auto-restores after this time.
//   isHidden     true → operator explicitly hides at this location.
//   source       who wrote this row ('manual' / 'square' / 'custom-webhook').
// locationTenantId is a child (location) tenant; the override is scoped
// to that location only. No FK on locationTenantId so a location tenant
// delete doesn't cascade-wipe the price book unexpectedly — overrides are
// cleaned up explicitly. menuItemId IS an FK (cascades with the item).
model MenuLocationOverride {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  locationTenantId String    @map("location_tenant_id")
  menuItemId       String    @map("menu_item_id")
  priceCents       Int?      @map("price_cents")
  isAvailable      Boolean   @default(true) @map("is_available")
  soldOutUntil     DateTime? @map("sold_out_until")
  isHidden         Boolean   @default(false) @map("is_hidden")
  source           String    @default("manual")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([locationTenantId, menuItemId])
  @@index([tenantId])
  @@index([menuItemId])
  @@index([locationTenantId])
  @@map("menu_location_overrides")
}

// A POS-provider-side location (Square `location_id`, Toast restaurant
// guid) mapped to one of our (child) location tenants. A 50-store chain
// has 50 PosLocation rows under one PosProviderConnection. `externalId`
// is the provider's location id. locationTenantId (optional) is the
// child tenant this location maps to — set when the operator assigns it.
model PosLocation {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  connectionId     String   @map("connection_id")
  externalId       String   @map("external_id")
  name             String
  address          String?
  // Which of our (child) location tenants this provider location feeds.
  // Null until the operator maps it. Used to resolve a screen → location.
  locationTenantId String?  @map("location_tenant_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  connection PosProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  screens    Screen[]

  @@unique([connectionId, externalId])
  @@index([tenantId])
  @@index([locationTenantId])
  @@map("pos_locations")
}

// Dayparting — VenueOS owns this (Square/Toast have no daypart
// primitive). A window of days-of-week + a local time range in a named
// timezone. Bound to MenuCategory so a section appears only in-window.
//   daysOfWeek: 0=Sunday .. 6=Saturday (matches Schedule/PlaylistItem).
//   timeStart/timeEnd: "HH:MM" 24-hour local time; wraparound supported.
//   timezone: IANA name (e.g. "America/Chicago").
model Daypart {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  daysOfWeek Int[]    @default([]) @map("days_of_week")
  timeStart  String   @map("time_start") // "HH:MM"
  timeEnd    String   @map("time_end") // "HH:MM"
  timezone   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  categories MenuCategory[]

  @@index([tenantId])
  @@map("dayparts")
}

// ─────────────────────────────────────────────────────────────────────
// Display control — screen on/off scheduling + vendor recipes (2026-08-13)
// ─────────────────────────────────────────────────────────────────────
//
// A wall-mounted screen that blanks at 22:00 and wakes at 07:00 MUST keep
// doing that with the network cut. So these rows are NOT a server-side cron:
// they ride the manifest to the player, which arms local AlarmManager
// alarms from them and re-arms on BOOT_COMPLETED. Server push
// (POST /screens/:id/display-control) is for immediate/manual actions only.
//
// Recurrence encoding follows Daypart, NOT Schedule: `daysOfWeek Int[]`
// (0=Sunday..6=Saturday) + "HH:MM" local times + an explicit IANA
// `timezone`. Schedule's comma-joined "Mon,Tue" string and implicit server
// timezone are both wrong for an on-device alarm — the player has to
// compute a real local wall-clock instant in the SCREEN's timezone, not the
// Android default (a district can span timezones, and a factory-reset box
// comes up on UTC).
//
// onTime > offTime is a legal overnight window: onTime 07:00 / offTime
// 22:00 is a normal day; onTime 18:00 / offTime 02:00 means the screen is
// lit 6 PM through 2 AM the next morning. Same wraparound contract as
// Daypart.timeStart/timeEnd and Tenant.otaWindowStart/End.
model DisplaySchedule {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  // Exactly ONE target: a single screen or a whole group. Enforced at the
  // API boundary (same contract as Schedule.screenId / screenGroupId).
  screenId      String?  @map("screen_id")
  screenGroupId String?  @map("screen_group_id")
  // Operator-facing label ("Weekday hours", "Friday night football").
  name          String?
  daysOfWeek    Int[]    @default([]) @map("days_of_week") // 0=Sun..6=Sat
  onTime        String   @map("on_time") // "HH:MM" local wake time
  offTime       String   @map("off_time") // "HH:MM" local blank time
  timezone      String // IANA, e.g. "America/Chicago"
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  screen      Screen?      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  screenGroup ScreenGroup? @relation(fields: [screenGroupId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([screenId])
  @@index([screenGroupId])
  @@map("display_schedules")
}

// Vendor display-control recipes — "a new vendor is a DB row, not an APK
// release." Goodview/Taurus/TCL each expose brightness + blank/wake through
// a different broadcast, sysfs node or Settings key; rather than bake a
// vendor SDK into the player we ship the RECIPE and let a generic executor
// run it.
//
// PLATFORM-OWNED, NOT TENANT-OWNED: deliberately has no tenantId. A recipe
// describes a hardware SKU, not a customer's data, and every tenant with
// that SKU needs the same one. Writes are SUPER_ADMIN-only.
//
// THE RECIPE IS UNTRUSTED INPUT AT THE PLAYER. It tells a device to fire
// broadcasts and write sysfs, so the player enforces a NATIVE allowlist no
// recipe can widen (sysfs canonicalized under /sys/class/backlight or
// /sys/class/leds; allowlisted broadcast action prefixes with no explicit
// component; Settings.System only — never Secure/Global; never a shell).
// The API validates the SHAPE on write; the device is the security boundary.
//
// MATCHING HAPPENS ON THE DEVICE, not here. The manifest ships the active
// catalog verbatim and the player picks the row whose `match` block fits its
// own Build.MANUFACTURER/MODEL/BOARD. That is what keeps the manifest's
// `display` block byte-identical across the fleet — it must not vary with
// Screen.displayCapabilities, or every capability report would bust the
// manifest hot cache (CLAUDE.md rule 7 / the 25 GB/mo egress bug).
model DisplayVendorRecipe {
  id        String   @id @default(uuid())
  // Stable slug, e.g. "goodview-ep6n", "novastar-taurus".
  vendorId  String   @unique @map("vendor_id")
  name      String
  // Full recipe document: { vendorId, match, brightness?, blank?, wake? }.
  // Shape validated by DisplayVendorRecipeSchema in @cms/api-types on write.
  recipe    Json
  isActive  Boolean  @default(true) @map("is_active")
  // Higher wins when two recipes match the same device.
  priority  Int      @default(0)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("display_vendor_recipes")
}

// Square delta-sync watermark, one row per connection. Square's
// `catalog.version.updated` / `SearchCatalogObjects begin_time` lets us
// pull only what changed since `lastCatalogVersion` / `lastSyncedAt`.
model MenuSyncCursor {
  connectionId       String    @id @map("connection_id")
  lastCatalogVersion String?   @map("last_catalog_version")
  lastSyncedAt       DateTime? @map("last_synced_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("menu_sync_cursors")
}

// ─────────────────────────────────────────────────────────────────────
// Ad-network integrations — Sprint 8d (2026-05-03)
// ─────────────────────────────────────────────────────────────────────
//
// Programmatic display advertising. Operators opt screens into a
// network, earn CPM-based revenue. We take a transaction fee.
//
// Three rows:
//   AdNetworkConnection — per-tenant connection to a network (auth +
//     content-safety preferences + revenue tally).
//   AdImpression — every impression delivered, used for revenue
//     calculation + audit. Aggregated nightly into AdRevenueDaily.
//   AdRevenueDaily — pre-aggregated daily revenue per (tenant, network)
//     for fast dashboard reads.
//
model AdNetworkConnection {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  networkId         String   @map("network_id") // canonical id from ad-network.ts
  encryptedCreds    String   @map("encrypted_creds")
  encryptedDataKey  String   @map("encrypted_data_key")
  status            String   @default("PENDING") // PENDING | ACTIVE | PAUSED | EXPIRED | REVOKED | ERROR
  statusReason      String?  @map("status_reason")
  // Operator's content-safety preferences. JSON.
  // { blockedCategories: ['IAB7', 'IAB8'], dayparts: [...],
  //   pauseDuringEmergency: true }
  contentControls   String   @map("content_controls")
  // Optional rev-share override (basis points). Falls back to the
  // network's default takeRateBps.
  takeRateBps       Int?     @map("take_rate_bps")
  // Cached running totals for fast dashboard reads. Updated by the
  // nightly aggregator.
  impressionsTotal  Int      @default(0) @map("impressions_total")
  grossRevenueCents Int      @default(0) @map("gross_revenue_cents")
  feeCents          Int      @default(0) @map("fee_cents")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdByUserId   String   @map("created_by_user_id")

  impressions  AdImpression[]
  revenueDaily AdRevenueDaily[]

  @@unique([tenantId, networkId])
  @@index([tenantId, status])
  @@map("ad_network_connections")
}

model AdImpression {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  connectionId       String   @map("connection_id")
  screenId           String   @map("screen_id")
  // Network-side creative + campaign identifiers (for audit + recon).
  externalCreativeId String   @map("external_creative_id")
  externalCampaignId String?  @map("external_campaign_id")
  cpmCents           Int      @map("cpm_cents") // CPM at time of serve
  // Computed on insert: cpmCents / 1000 (the per-impression rev).
  revenueCents       Int      @map("revenue_cents")
  servedAt           DateTime @default(now()) @map("served_at")

  connection AdNetworkConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, servedAt])
  @@index([connectionId, servedAt])
  @@index([screenId, servedAt])
  @@map("ad_impressions")
}

// Daily aggregate — one row per (tenant, network, date). Populated
// by a nightly cron from ad_impressions. Dashboard queries hit this
// instead of scanning the impression log.
model AdRevenueDaily {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  connectionId      String   @map("connection_id")
  date              DateTime @db.Date
  impressions       Int      @default(0)
  grossRevenueCents Int      @default(0) @map("gross_revenue_cents")
  feeCents          Int      @default(0) @map("fee_cents")

  connection AdNetworkConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date])
  @@index([tenantId, date])
  @@map("ad_revenue_daily")
}

// ─────────────────────────────────────────────────────────────
// VenueOS Sports — Sprint 13. A live game + its event log.
//
// A Game is one contest. The scoreboard board page renders from it;
// the operator control page mutates it. The clock is stored as an
// ANCHOR, not a ticking value: `clockMs` is the clock reading at
// `clockUpdatedAt`, and `clockRunning` says whether it's advancing.
// The board page computes the live displayed clock from those three
// — so the server never has to tick. Pausing/resuming just recomputes
// and re-anchors clockMs.
//
// `stats` is sport-specific JSON keyed by SportDefinition.stats[].key
// (down/distance, balls/strikes, fouls, sets won, …). Additive —
// new tables only, safe for live pilot tenants.
// ─────────────────────────────────────────────────────────────
model Game {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  sport          String // SportDefinition key
  homeTeam       String    @map("home_team")
  awayTeam       String    @map("away_team")
  homeScore      Int       @default(0) @map("home_score")
  awayScore      Int       @default(0) @map("away_score")
  segment        Int       @default(1) // current quarter/inning/set/period
  clockMs        Int       @default(0) @map("clock_ms") // clock reading at clockUpdatedAt
  clockRunning   Boolean   @default(false) @map("clock_running")
  clockUpdatedAt DateTime  @default(now()) @map("clock_updated_at")
  stats          Json      @default("{}") // sport-specific stat values
  spotlight      Json      @default("{}") // broadcast spotlight: featured player / promo
  status         String    @default("SCHEDULED") // SCHEDULED|PRE_GAME|LIVE|HALFTIME|FINAL
  screenGroupId  String?   @map("screen_group_id") // surfaces showing this game
  homeColor      String?   @map("home_color")
  awayColor      String?   @map("away_color")
  homeLogoUrl    String?   @map("home_logo_url") // team brand mark on the scoreboard
  awayLogoUrl    String?   @map("away_logo_url")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  // 2026-05-27 — T2-8: possession arrow as a first-class field.
  // Replaces the free-text `stats.possession` approach — the operator
  // no longer types 'home'/'away' into a generic stat field. The column
  // is nullable so existing Game rows are unaffected (migration is
  // additive-only). Display surfaces fall back to stats.possession for
  // backward compat when this column is null.
  possession String? // 'home' | 'away' | null

  // 2026-05-31 — Sprint 13 feed-token REVOCATION. The external score-feed
  // credential (sports-feed-token.ts) is a stateless game-scoped HMAC handed
  // to a Sportzcast/Scorebird/console-bridge vendor. This counter is folded
  // into the token MAC so bumping it (SportsService.revokeFeedToken / the
  // POST games/:id/revoke-feed-token endpoint) instantly invalidates every
  // outstanding token for the game — the per-game kill-switch for a leaked or
  // rotated credential. Defaults to 0; verify treats version 0 as the LEGACY
  // bare "feed:<id>" MAC, so every token already deployed in the field keeps
  // verifying unchanged (additive-only migration, no break to a live bridge).
  feedTokenVersion Int @default(0) @map("feed_token_version")

  // 2026-08-09 — Phase-2 Domain SHARE: scorekeeper console share-link
  // revocation. The console share token (sports-console-token.ts) is a
  // stateless game-scoped HMAC handed to a student/volunteer scorekeeper as a
  // /console/<token> link + QR — LIMITED in-game controls (score / clock /
  // segment / timeouts / celebration cues), no tenant account. This counter is
  // folded into the token MAC ("console:<gameId>:<ver>:<iat>:<ttl>") so
  // bumping it (SportsService.revokeConsoleShare / DELETE
  // /sports/games/:id/console-share) instantly invalidates every outstanding
  // link for the game. Additive-only (default 0) — existing rows unaffected;
  // deliberately a SEPARATE counter from feedTokenVersion so revoking a
  // scorekeeper's link never kills a vendor's feed credential (or vice versa).
  consoleTokenVersion Int @default(0) @map("console_token_version")

  // 2026-05-19 — Sprint 13 scoreboard builder. Each game can pick an
  // operator-customized Template for its three surfaces:
  //   * scoreboardTemplate → /board/[gameId]  (the big LED video wall)
  //   * ribbonTemplate     → /ribbon/[gameId] (the perimeter ribbon)
  //   * scorebugTemplate   → /scorebug/[gameId] (the OBS broadcast bug)
  // All three are nullable: a NULL value falls back to the legacy
  // hardcoded layout in apps/web/src/app/board|ribbon|scorebug. This
  // lets every existing Game in the database keep working unchanged
  // while customers progressively opt into custom layouts. SetNull
  // on the FK so deleting a template never wipes a game row.
  scoreboardTemplateId String? @map("scoreboard_template_id")
  ribbonTemplateId     String? @map("ribbon_template_id")
  scorebugTemplateId   String? @map("scorebug_template_id")

  // 2026-06-15 — Sprint 13 player-stats / records engine (Phase 2).
  // Optional links from a game's two sides to a persistent `Team`
  // program. Drives record-scoping ("school record across all Varsity
  // Basketball seasons") which plain `homeTeam`/`awayTeam` strings can't
  // express reliably. Nullable everywhere — existing games keep their
  // string sides; SetNull so deleting a Team never wipes a game row.
  homeTeamId String? @map("home_team_id")
  awayTeamId String? @map("away_team_id")

  // 2026-07-02 — Sports Wave S4-1 (P1-8, deep-pass audit): games had no
  // date/time. The create modal never asked, the list was ungrouped, and
  // COUNTDOWN/PreGameScene had no target to count down to. Optional —
  // nullable so every existing Game row (and every SCHEDULED game created
  // before this shipped) stays perfectly legal with no value. When set, the
  // web list uses it to order upcoming games and render "Tonight 7:00 PM"
  // style copy; a future COUNTDOWN wiring can target it. Purely additive.
  scheduledAt DateTime? @map("scheduled_at")

  // 2026-08-10 — Inputs-wave SCHED: schedule game mode. When the operator
  // arms auto-push, this is the moment the board goes up on the selected
  // screens: scheduledAt − 10 minutes (baked default, no knob). NULL means
  // "nothing pending" — not armed, already pushed, cancelled at FINAL, or
  // disarmed. The GameScheduleService sweep claims due rows by atomically
  // nulling this column (UPDATE … RETURNING — replica-safe, like the
  // webhook-retry worker), so a value survives only until it fires. Which
  // screens/surface (and the saved state to restore at FINAL) rides a
  // latest-wins AUTO_PUSH GameEvent. Nullable → purely additive.
  autoPushAt DateTime? @map("auto_push_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events GameEvent[]
  roster RosterPlayer[]

  scoreboardTemplate Template? @relation("GameScoreboardTemplate", fields: [scoreboardTemplateId], references: [id], onDelete: SetNull)
  ribbonTemplate     Template? @relation("GameRibbonTemplate", fields: [ribbonTemplateId], references: [id], onDelete: SetNull)
  scorebugTemplate   Template? @relation("GameScorebugTemplate", fields: [scorebugTemplateId], references: [id], onDelete: SetNull)

  homeTeamRef Team? @relation("GameHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamRef Team? @relation("GameAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  // 2026-07-02 efficiency #3 — serves ClockAdvanceService's tenant-less
  // sweep (status='LIVE' AND clock_running=true), which can't use the
  // (tenantId, status) index's leading column.
  @@index([status, clockRunning])
  @@index([scoreboardTemplateId])
  @@index([ribbonTemplateId])
  @@index([scorebugTemplateId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  // Sports Wave S4-1 — serves the "upcoming games" list ordering query
  // (tenant-scoped, sorted by scheduledAt).
  @@index([tenantId, scheduledAt])
  // Inputs-wave SCHED — serves GameScheduleService's tenant-less due-push
  // sweep (auto_push_at <= NOW()); no tenant-leading index can.
  @@index([autoPushAt])
  @@map("games")
}

// Sports roster — a player on a Game's home or away side. Carries the
// headshot URL + a flexible stat map so a scoreboard / ribbon can
// surface player-of-the-game, stat leaders, and starting-lineup
// content. Per-game (the Game model holds teams as plain strings — no
// Team entity yet); a future Team model can lift these up without a
// breaking change.
model RosterPlayer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  gameId    String   @map("game_id")
  team      String // 'home' | 'away'
  name      String
  number    String? // jersey number — string ("00", "G")
  position  String?
  photoUrl  String?  @map("photo_url")
  stats     Json     @default("{}") // flexible { AVG: ".312", HR: "19", … }
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // 2026-06-15 — Sprint 13 player-stats / records engine (Phase 2).
  // The back-link from a per-game appearance to the persistent athlete
  // identity (`SportsPerson`) + the program (`Team`). Both nullable:
  // null = today's behavior exactly (a one-off / unlinked roster row).
  // The aggregation in finalizeGameStats only rolls up appearances where
  // personId is set, so opponents / typos never pollute the persistent
  // tables. SetNull on both so deleting a person/team never wipes the
  // game's roster history.
  personId String? @map("person_id")
  teamId   String? @map("team_id")

  game    Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  person  SportsPerson? @relation("PersonAppearances", fields: [personId], references: [id], onDelete: SetNull)
  teamRef Team?         @relation("TeamRosterAppearances", fields: [teamId], references: [id], onDelete: SetNull)

  @@index([gameId, team, sortOrder])
  @@index([personId])
  @@map("roster_players")
}

// Append-only event log for a Game — every score change, clock
// action, segment advance, stat edit, and celebration CUE. Drives
// the celebration playback on the board page (it polls for fresh
// CUE events) and is the forensic record of the game.
model GameEvent {
  id        String   @id @default(uuid())
  gameId    String   @map("game_id")
  type      String // SCORE|CLOCK|SEGMENT|STAT|CUE|STATUS
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, createdAt])
  // 2026-06-15 — the board reads the cue/event feed per TYPE (WHERE gameId AND
  // type ORDER BY createdAt); the (gameId, createdAt) index can't serve the
  // type predicate, so Postgres was scanning all events for the game and
  // filtering in memory (live 33.5% seq scans). This serves the per-type path.
  @@index([gameId, type, createdAt])
  @@map("game_events")
}

// ─────────────────────────────────────────────────────────────
// VenueOS Sports — Sprint 13 Phase 2. A venue sponsor / advertiser.
//
// Sponsorship is the buying trigger for school athletics — a gym
// scoreboard that sells local ads pays for itself. A Sponsor is one
// advertiser; active sponsors rotate through the scoreboard's banner
// slot. `weight` is how many slots per rotation cycle the sponsor
// gets (a Title sponsor shows more often than a Community one).
//
// Proof-of-play has TWO surfaces: a tenant-wide ARITHMETIC ESTIMATE
// (the report endpoint divides each game's live duration across active
// sponsors by weight — no impression rows needed) AND real per-game,
// per-surface counts aggregated from the `SponsorImpression` rows below,
// which the public board/ribbon write fire-and-forget as a sponsor look
// enters view. The estimate is the quick glance; the impression rows are
// the renewal-closing proof ("ran 41× on the ribbon, 28× on the board").
//
// Additive — one new table, safe for live pilot tenants.
// ─────────────────────────────────────────────────────────────
model Sponsor {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  name                String
  logoUrl             String?   @map("logo_url")
  tagline             String?
  color               String? // brand hex for the banner accent
  tier                String? // freeform label: Title | Gold | Community …
  weight              Int       @default(1) // rotation slots per cycle
  active              Boolean   @default(true)
  // Ad-ops flight window — null = no bound on that side.
  flightStartAt       DateTime? @map("flight_start_at") // inclusive; null = always started
  flightEndAt         DateTime? @map("flight_end_at") // exclusive; null = never expires
  frequencyCapPerHour Int?      @map("frequency_cap_per_hour") // max airings / hr; null = uncapped
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  impressions SponsorImpression[]

  @@index([tenantId, active])
  @@map("sponsors")
}

// VenueOS Sports — per-impression log for real sponsor proof-of-play.
// Written fire-and-forget from board/ribbon/scorebug pages each time a
// sponsor look enters view. Enables per-game reports that count real
// airings per surface — replacing the arithmetic estimate in report().
//
// Additive — new table only, safe for live pilot tenants.
// Generated with --create-only on 2026-05-27; lead applies on merge.
model SponsorImpression {
  id          String   @id @default(uuid())
  sponsorId   String   @map("sponsor_id")
  gameId      String   @map("game_id")
  surfaceKind String   @map("surface_kind") // 'board' | 'ribbon' | 'scorebug'
  ts          DateTime @default(now())

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId, ts])
  @@index([gameId, ts])
  @@map("sponsor_impressions")
}

// VenueOS Sports — the cue deck. A CustomCue is an operator-defined
// trigger: a named button with uploaded content (a graphic) that, on
// click, fires a full-screen takeover on the scoreboard. Per-tenant
// and reusable across every game — the operator builds the deck once.
// Additive — one new table, no FK; safe for live pilot tenants.
model CustomCue {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String // trigger button label
  mediaUrl    String?  @map("media_url") // uploaded graphic
  color       String? // accent / background color
  durationMs  Int      @default(6000) @map("duration_ms")
  // 2026-05-20 — operator: "the custom cues took over the entire screen,
  // they should overlay." How the cue renders on the board:
  //   overlay  → board stays visible; media drops into a lower band
  //   takeover → full-screen opaque media (the original behavior)
  // Defaults to overlay (the expected behavior); takeover is opt-in.
  displayMode String   @default("overlay") @map("display_mode")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId, sortOrder])
  @@map("custom_cues")
}

// 2026-05-27 — One-click Bug Reporter. Operator vision: user finds a
// bug → clicks button → system captures everything → AI analyzes →
// operator approves → fix ships. End-to-end target: 10 minutes.
//
// Bug.capturedContext is the client-side bundle (screenshot URL,
// URL, viewport, console errors, network failures, recent breadcrumbs,
// React Query state, user/tenant/role). Shape defined in
// @cms/api-types as `BugCapturedContext`.
//
// Bug.serverContext is server-side enrichment added at POST time
// (recent AuditLog rows for the user + tenant, license state, deploy
// SHA, Redis/DB health). Shape defined as `BugServerContext`.
//
// Bug.aiAnalysis is the structured output from the Anthropic API call
// (rootCause, filesAffected, suggestedDiff, confidence). Shape
// defined as `BugAiAnalysis`. Null until status moves past 'ANALYZING'.
//
// Status state machine:
//   NEW → ANALYZING → PROPOSED → APPROVED → SHIPPED
//                              → REJECTED
//                              → DUPLICATE
//   At any point: REJECTED (operator gave up) or DUPLICATE (linked to
//   another bug id via rejected_reason).
model Bug {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id")
  userId          String?   @map("user_id")
  status          String    @default("NEW")
  description     String?   @db.Text
  screenshotUrl   String?   @map("screenshot_url")
  capturedContext Json      @map("captured_context")
  serverContext   Json?     @map("server_context")
  aiAnalysis      Json?     @map("ai_analysis")
  aiAnalyzedAt    DateTime? @map("ai_analyzed_at")
  aiProvider      String?   @map("ai_provider")
  aiModel         String?   @map("ai_model")
  aiCostUsd       Float?    @map("ai_cost_usd")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  fixBranchName   String?   @map("fix_branch_name")
  fixPrNumber     Int?      @map("fix_pr_number")
  fixCommitSha    String?   @map("fix_commit_sha")
  shippedAt       DateTime? @map("shipped_at")
  rejectedReason  String?   @map("rejected_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user       User?   @relation("BugReporter", fields: [userId], references: [id], onDelete: SetNull)
  approvedBy User?   @relation("BugApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("bugs")
}

// ═════════════════════════════════════════════════════════════════
// VenueOS Sports — Phase 2: persistent player-stats / records engine.
// 2026-06-15. Spec: docs/research/2026-06-15-sports-pro-gap-analysis/
// 01-STATS-ENGINE-SPEC.md (PHASE 2).
//
// Phase 1 already ships per-game `RosterPlayer` rows (a player on ONE
// game's home/away side). Phase 2 adds the PERSISTENT spine on top:
//
//   Team           — a program/squad ("Varsity Boys Basketball"); NOT
//                    a game side. `isHome` marks OUR programs.
//   SportsPerson   — the persistent athlete; `normalizedKey` dedups on
//                    CSV re-import; `RosterPlayer.personId` links each
//                    appearance back to one of these.
//   PlayerSeasonStat / PlayerCareerStat — materialized aggregates the
//                    finalize pass upserts; leaderboards read the
//                    `(…, statValue Desc)` index, never recompute.
//   StatRecord     — the record book (one row per scope/stat slot);
//                    `holderName` denormalized so deleting a person
//                    doesn't blank the board.
//   StatMilestoneDef — seeded milestone definitions; `tenantId = null`
//                    is a global default, a tenant row shadows it.
//   PlayerMilestone  — fired-milestone ledger; `(personId, dedupeKey)`
//                    unique is the replay-defense (multi-replica safe).
//
// DB is pre-customer (no live sports data), so these are clean models —
// FK columns added to `Game`/`RosterPlayer` above are nullable so the
// pilot's existing string-sided games keep working untouched.
// ═════════════════════════════════════════════════════════════════

// A program / squad — "Varsity Boys Basketball" — owned by a tenant.
// NOT a game side (Game.homeTeam/awayTeam stay plain strings for
// opponents). `isHome` = true means this is OUR program: only our
// programs' athletes roll up into the persistent stat tables.
model Team {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String // "Varsity Boys Basketball"
  sport        String // SportDefinition key
  season       String? // e.g. "2025-26"; null = all-seasons program
  gender       String? // "boys" | "girls" | "coed" | …
  level        String? // "Varsity" | "JV" | "Freshman" | …
  colorPrimary String?  @map("color_primary") // brand hex for the program
  logoUrl      String?  @map("logo_url")
  isHome       Boolean  @default(true) @map("is_home") // true = OUR program
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  persons           SportsPerson[]
  rosterAppearances RosterPlayer[] @relation("TeamRosterAppearances")
  homeGames         Game[]         @relation("GameHomeTeam")
  awayGames         Game[]         @relation("GameAwayTeam")

  @@index([tenantId, sport, season])
  @@map("sports_teams")
}

// The persistent athlete. Survives across games and seasons. A
// per-game `RosterPlayer` links to one of these via `personId`.
// `normalizedKey` (lowercased/trimmed name) is the CSV-reimport dedup
// key; `externalRef` is the forward-hook for GameChanger/MaxPreps ids.
model SportsPerson {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  teamId        String?  @map("team_id")
  fullName      String   @map("full_name")
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  number        String? // jersey number — string ("00", "G")
  position      String?
  photoUrl      String?  @map("photo_url")
  gradYear      Int?     @map("grad_year")
  normalizedKey String   @map("normalized_key") // lowercased/trimmed name → dedup
  externalRef   String?  @map("external_ref") // GameChanger/MaxPreps id (future)
  active        Boolean  @default(true)
  // 2026-06-22 — player-stats S1: shareable public athlete profile. OFF by
  // default (a minor is never exposed until an operator opts in). Access is by
  // the unguessable token, NOT the person id (no enumeration); revoke = set
  // isPublic false; rotate = re-issue the token. Both additive + nullable.
  isPublic         Boolean @default(false) @map("is_public")
  publicShareToken String? @unique @map("public_share_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team        Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  appearances RosterPlayer[]     @relation("PersonAppearances")
  seasonStats PlayerSeasonStat[]
  careerStats PlayerCareerStat[]
  milestones  PlayerMilestone[]

  @@unique([tenantId, teamId, normalizedKey, gradYear], name: "tenant_person_identity")
  @@index([tenantId, teamId])
  @@map("sports_persons")
}

// Materialized per-person-per-season-per-stat aggregate. The finalize
// pass upserts these on FINAL; leaderboards read the
// (sport, season, statKey, statValue Desc) index directly.
model PlayerSeasonStat {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  personId     String   @map("person_id")
  teamId       String?  @map("team_id")
  sport        String // SportDefinition key
  season       String
  statKey      String   @map("stat_key") // key from PLAYER_STATS
  statValue    Float    @default(0) @map("stat_value")
  gamesPlayed  Int      @default(0) @map("games_played")
  displayValue String?  @map("display_value")
  lastGameId   String?  @map("last_game_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  person SportsPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  Tenant Tenant       @relation(fields: [tenantId], references: [id])

  // `sport` is part of the identity (2026-07-04): a SportsPerson is ONE
  // persistent athlete across ANY sport, and PLAYER_STATS codes collide across
  // sports (AST/PTS/G/A/BLK/TD/HR…). Without `sport` in the key, a multi-sport
  // athlete's same-code stats merged into one row, corrupting per-sport
  // leaderboards + the record book.
  @@unique([personId, season, statKey, sport], name: "person_season_stat")
  @@index([tenantId, sport, season, statKey, statValue(sort: Desc)])
  @@map("player_season_stats")
}

// Materialized per-person-per-stat CAREER aggregate (same shape as
// PlayerSeasonStat, minus `season`). Recomputed by the finalize pass.
model PlayerCareerStat {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  personId     String   @map("person_id")
  teamId       String?  @map("team_id")
  sport        String // SportDefinition key
  statKey      String   @map("stat_key") // key from PLAYER_STATS
  statValue    Float    @default(0) @map("stat_value")
  gamesPlayed  Int      @default(0) @map("games_played")
  displayValue String?  @map("display_value")
  lastGameId   String?  @map("last_game_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  person SportsPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  Tenant Tenant       @relation(fields: [tenantId], references: [id])

  // `sport` is part of the identity — see PlayerSeasonStat above (2026-07-04).
  @@unique([personId, statKey, sport], name: "person_career_stat")
  @@index([tenantId, sport, statKey, statValue(sort: Desc)])
  @@map("player_career_stats")
}

// The record book — one row per (scope, stat) slot holding the CURRENT
// best. `teamId = null` = school-wide. `holderName` is denormalized so
// a deleted person doesn't blank the board. `higherIsBetter` lets a
// stat where lower is better (e.g. ERA) record correctly.
model StatRecord {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  teamId         String?   @map("team_id") // null = school-wide
  sport          String // SportDefinition key
  statKey        String    @map("stat_key")
  scope          String    @default("SCHOOL") // SCHOOL | TEAM | …
  season         String? // null for career/school totals
  recordType     String    @default("SINGLE_GAME") @map("record_type") // SINGLE_GAME | SEASON_TOTAL | CAREER_TOTAL
  value          Float
  displayValue   String?   @map("display_value")
  holderPersonId String?   @map("holder_person_id")
  holderName     String    @map("holder_name") // denormalized — survives person delete
  gameId         String?   @map("game_id")
  setOn          DateTime? @map("set_on")
  higherIsBetter Boolean   @default(true) @map("higher_is_better")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teamId, sport, statKey, scope, season, recordType], name: "record_slot")
  @@map("stat_records")
}

// Seeded milestone definitions. `tenantId = null` is a global default
// (seeded from MILESTONE_DEFS); a tenant row shadows the global one.
// `kind` = THRESHOLD (hit N), RECORD (broke a record), NTH (Nth of X).
model StatMilestoneDef {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id") // null = global default; tenant rows shadow
  sport     String // SportDefinition key
  statKey   String   @map("stat_key")
  kind      String // THRESHOLD | RECORD | NTH
  threshold Float?
  label     String
  cueKey    String   @map("cue_key") // e.g. 'CEL_MILESTONE_RECORD'
  emoji     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sport])
  @@map("stat_milestone_defs")
}

// Fired-milestone ledger. `(personId, dedupeKey)` unique is the
// replay-defense (multi-replica safe — DB-level, not in-memory).
// `celebratedAt` latches when the board plays it so it fires once.
model PlayerMilestone {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  personId     String    @map("person_id")
  gameId       String?   @map("game_id")
  sport        String // SportDefinition key
  statKey      String    @map("stat_key")
  label        String
  cueKey       String    @map("cue_key")
  dedupeKey    String    @map("dedupe_key") // replay defense
  celebratedAt DateTime? @map("celebrated_at")
  firedAt      DateTime  @default(now()) @map("fired_at")

  person SportsPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  Tenant Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([personId, dedupeKey], name: "person_milestone_dedupe")
  @@index([tenantId, gameId])
  @@map("player_milestones")
}

// Durable revocation backstop (2026-07-10 — external-audit fix).
// Redis stays the PRIMARY, hot-path revocation store (`jwt_revoked_list`
// + `jwt_invalid_before:<userId>`); every revocation write is MIRRORED
// here so a previously-revoked credential stays revoked while Redis is
// degraded or down. Read ONLY on the Redis-unavailable fallback path in
// RedisService — never on the redis-up hot path.
//
// kind = 'jti'                 → key = sha256 hex of the exact bearer
//                                token (never the raw token: a DB dump
//                                must not contain live credentials),
//                                value unused.
// kind = 'user_invalid_before' → key = userId, value = epoch SECONDS;
//                                any user JWT with iat < value is dead.
//
// expiresAt mirrors the Redis TTL (30d rememberMe ceiling) — by then the
// underlying JWT has expired on its own, so expired rows are inert and
// prunable at leisure.
model RevokedCredential {
  id        String    @id @default(uuid())
  kind      String // 'jti' | 'user_invalid_before'
  key       String
  value     String?
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  // The fallback lookup is exactly (kind, key) → row; unique also makes
  // the dual-write an idempotent upsert.
  @@unique([kind, key])
  // Opportunistic pruning of expired rows without a seq scan.
  @@index([expiresAt])
  @@map("revoked_credentials")
}
