{
  "name": "@cms/database",
  "version": "1.0.0",
  "main": "index.js",
  "types": "index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "node ../../scripts/guard-destructive-db.cjs db:migrate && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "node ../../scripts/guard-destructive-db.cjs db:push && prisma db push",
    "db:seed": "node ../../scripts/guard-destructive-db.cjs db:seed && tsx prisma/seed.ts",
    "db:reset": "node ../../scripts/guard-destructive-db.cjs db:reset && prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "argon2": "^0.44.0",
    "prisma": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
