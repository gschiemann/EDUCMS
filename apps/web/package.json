{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 60",
    "Android >= 60",
    "Edge >= 79",
    "Firefox >= 60",
    "Safari >= 12",
    "iOS >= 12"
  ],
  "scripts": {
    "dev": "node scripts/emit-locale-catalogs.cjs && next dev",
    "build": "node scripts/build-info.cjs && node scripts/emit-locale-catalogs.cjs && next build",
    "start": "next start",
    "lint": "eslint",
    "lhci": "lhci autorun",
    "a11y:ci": "tsx scripts/a11y-audit.ts",
    "test:cross-browser": "node tests/cross-browser/holiday-bridge.cjs && node tests/cross-browser/k12-menu-bridge.cjs && node tests/cross-browser/k12-backlog-bridge.cjs && node tests/cross-browser/gym-media-boards.cjs && node tests/cross-browser/designer-fit-engine.cjs && node tests/cross-browser/text-style-contract.cjs && node tools/check-port-fidelity.cjs",
    "test:celebrations": "node tests/cross-browser/celebrations-bridge.cjs",
    "test:kiosk-shim": "node tests/cross-browser/kiosk-edit-shim.cjs",
    "test:text-style-contract": "node tests/cross-browser/text-style-contract.cjs",
    "test:prod-smoke": "node tests/cross-browser/prod-smoke.cjs",
    "test:webkit-nav": "node tests/cross-browser/webkit-nav-smoke.cjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:emergency-path": "playwright test --config playwright.config.ts tests/e2e/emergency-path.spec.ts",
    "test:e2e:widget-render": "playwright test --config playwright.config.ts tests/e2e/widget-render.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cms/api-types": "workspace:*",
    "@cms/scoreboard-cts": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@growthbook/growthbook": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@openfeature/core": "^1.12.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@sentry/nextjs": "^10.75.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "hls.js": "^1.7.3",
    "html-to-image": "1.11.13",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-leaflet": "^5.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.13.0",
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
