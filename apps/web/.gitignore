# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
tests/cross-browser/report.json
tests/cross-browser/celebrations-report.json
tests/cross-browser/prod-smoke-report.json
tests/cross-browser/prod-smoke-shots/
# build-time copies of src/i18n/messages/{es,zh}.json (scripts/emit-locale-catalogs.cjs)
/public/locales/
