<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires a typed FGS permission. dataSync covers the
         heartbeat ping payload; if we ever add live audio/video capture
         we'd need 'mediaProjection' or similar. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- OTA self-install. Without this the install intent silently no-ops
         on Android 8+. Tenant must accept the install prompt OR set us
         as the default installer via `pm set-installer com.educms.player`
         (one-shot ADB), which makes installs silent.  -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- v1.0.53 — RE-ADDED. Operator: "remote upgrade has NEVER
         worked, no update workflow." Root cause: Player had this
         permission STRIPPED in v1.0.21 during an unrelated crash
         debug (the v1.0.20 VerifyError was actually caused by
         leaking API-31 symbols into Android-11-loaded classes, NOT
         by this permission). Without UPDATE_PACKAGES_WITHOUT_USER_ACTION,
         even when Player IS its own installer-of-record (every
         post-first-install scenario), PackageInstaller.commit()
         returned STATUS_PENDING_USER_ACTION on Android 12+, forcing
         a tap-to-install dialog every single time.

         WITH this permission declared AND USER_ACTION_NOT_REQUIRED
         set on the session params (see Api31SilentInstall.configure
         in Player's ota package), Android honors silent install when:
            (a) caller is DEVICE_OWNER (we're not — no factory provisioning), OR
            (b) caller is installer-of-record for the target package
                AND target is the calling app updating itself.

         Path (b) is the retrofit silent-update pattern. After the
         FIRST Player-driven install (which still requires one user
         tap because Player isn't installer-of-record yet on a
         sideloaded device), Player BECOMES installer-of-record for
         itself (PackageInstaller records the calling package). From
         v1.0.54 onwards: EVERY OTA installs silently. ZERO taps.

         This is the standard Android pattern that every legitimate
         signage CMS uses (Yodeck, Rise Vision, etc.) for non-DEVICE_OWNER
         deployments. We had this 80% wired and lost the last 20% in
         a panic-revert. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!--
      Permission to write to the Manager APK's PlayerHealthProvider
      (Phase 1 of the multi-APK architecture, see
      scratch/manager-apk/01-architecture-decision.md). Manager's
      manifest declares this permission with signature-only protection
      level, so only apps signed with the same debug keystore (i.e.
      our own Player + Manager) can hold it.

      Safe to declare even when Manager isn't installed: Android
      simply doesn't grant the permission and ContentResolver writes
      silently fail. ManagerHeartbeatPublisher handles that case.
    -->
    <uses-permission android:name="com.educms.manager.HEALTH_PERMISSION" />

    <!-- Android 11+ scoped queries: Manager runs in a different UID,
         we need to declare we want to talk to it. v1.0.22+ also
         declares the system PackageInstaller activity packages so
         we can resolve EXTRA_INTENT from STATUS_PENDING_USER_ACTION
         on Goodview's stripped TaurusOS (which doesn't ship GMS;
         the system installer is com.android.packageinstaller, not
         the Google variant). -->
    <queries>
        <package android:name="com.educms.manager" />
        <package android:name="com.educms.manager.debug" />
        <provider android:authorities="com.educms.manager.health" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
    </queries>

    <!-- USB OTG sneakernet ingest (Sprint 7B) — Android 7+ supports USB host mode -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".PlayerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduCmsPlayer"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- MainActivity is THE ONLY entry point. The WebView loads
             /player which handles the whole register → show pairing
             code → poll → play flow inside the web app. The APK is a
             kiosk shell; there is NO native pairing screen.
             PairingActivity was removed entirely (commit addressing
             operator-report 2026-04-20: some TV auto-launchers cached
             it as the default activity across app updates and showed
             the old "type your code" keyboard prompt on boot instead
             of the WebView). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:resizeableActivity="false"
            tools:ignore="LockedOrientationActivity"
            android:windowSoftInputMode="adjustNothing|stateAlwaysHidden"><!--
              2026-05-05 (v1.0.50) — operator: ".49 same fucking bug,
              search locations on e-arc.com and when i click in the
              search field i get the keyboard and the black bar at the
              top and then close the keyboard and it stays".

              v1.0.49 attempt was to re-hide system bars on every IME
              transition (theory: status bar reappearing). That didn't
              fix it. Real cause appears to be Android's adjustResize
              behavior on this OEM ROM (Goodview / NovaStar TaurusOS):
              with setDecorFitsSystemWindows(false) + adjustResize, the
              decor view's resize can land in a state where the WebView
              is pushed DOWN by the IME inset, exposing the
              FrameLayout's black background at the TOP. Closing the
              IME doesn't reliably restore the layout.

              Fix: `adjustNothing` + WindowInsets.CONSUMED listener (in
              MainActivity.kt) so the WebView NEVER moves on IME open.
              The keyboard slides up as a transparent overlay; it can
              cover the bottom portion of the WebView, but no black bar
              ever appears at the top because nothing in our layout
              ever shifts.

              Trade-off: an input field at the very bottom of the page
              (e.g. y > 50% of screen) may be obscured by the keyboard.
              Mitigation: e-arc.com's search field is at the top, and
              for cases where the input is genuinely below the fold,
              the page's CSS scroll-into-view (fired by focus events)
              will scroll the input above the keyboard within the
              WebView's own scroll. We're choosing "input maybe
              obscured for one tap" over "permanent black bar".

              `stateAlwaysHidden` preserved — never auto-pop the
              keyboard on activity start.
        -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.educms.player.OPEN_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- DELIBERATELY NO HOME category. We learned the hard way
                 2026-04-21 that registering `category.HOME` makes Android
                 treat us as a candidate launcher replacement. On OEM
                 signage boxes (Goodview, NovaStar, TCL) that already ship
                 a proprietary CMS/launcher, Android promptly asks the
                 user to pick a default — and if our app ever wins that
                 vote (or if we're the only launcher registered), we
                 DISPLACE the OEM launcher entirely. Goodview's own CMS
                 stops being reachable, their network-settings flow
                 breaks, and the screen drops off their dashboard. We
                 are a guest on the device, NOT the host. The OEM's CMS
                 is the launcher; we are an app they start. Leave this
                 comment in place; do NOT re-add HOME. If a customer
                 explicitly wants us as the kiosk launcher (no OEM CMS
                 underneath), ship a separate build flavor with the
                 HOME filter gated behind a `isKioskOnly` gradle flag.
              -->
            <!-- Backstop intent alias for the old com.educms.player.LEGACY_PAIR
                 action. TV auto-launchers that pinned that action at some
                 point in the past now route to MainActivity instead of
                 trying to resolve a missing activity (which would crash). -->
            <intent-filter>
                <action android:name="com.educms.player.LEGACY_PAIR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          v1.0.64 — Kiosk HOME alias. THE fix for "the upgrade never
          fully works": after an OTA install Android 14 will not let
          the Player launch its own MainActivity from the background
          (BAL — Background Activity Launch — is blocked, and the
          MY_PACKAGE_REPLACED grant is FGS-only). Three versions of
          receiver/FGS tricks all failed against this OS policy.

          The canonical kiosk pattern (Yodeck / Rise Vision / every
          Android Enterprise dedicated-device guide): make the player
          the HOME launcher. When the player IS home, the OS itself
          returns to it after ANY death — OTA self-update, crash,
          reboot — as a SYSTEM-initiated launch that BAL never blocks.

          Why an alias, disabled by default, instead of adding
          category.HOME straight onto MainActivity: see the long
          comment on MainActivity above. On OEM-CMS signage boxes
          (Goodview / NovaStar / TCL) an unconditional HOME filter
          makes Android prompt "pick a launcher" and can displace the
          vendor's own CMS launcher. We must NOT do that to a box
          where we're a guest.

          So: this alias ships DISABLED. It is enabled at runtime
          ONLY when the Player detects that the Manager companion is
          the device owner (DevicePolicyManager.isDeviceOwnerApp) —
          i.e. only on a deliberately-provisioned EduCMS kiosk where
          owning the home screen is the intended behavior. Manager
          (the device owner) then calls
          DevicePolicyManager.addPersistentPreferredActivity() to pin
          this alias as the HOME handler with no chooser dialog.

          exported=true is required — the system launches HOME.
          singleTask (inherited from targetActivity) is correct for
          a launcher. See PlayerApp.kt (enable logic) and Manager's
          ManagerApp.pinPlayerAsHome().
        -->
        <activity-alias
            android:name=".KioskHomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <!--
              v1.0.61 — same receiver also catches ACTION_MY_PACKAGE_REPLACED so
              the Player auto-relaunches after every OTA install. Operator on
              v1.0.59 sandbox test (2026-05-15): post-install logcat showed
              `ActivityTaskManager: Background activity launch blocked
              [callingPackage: com.educms.manager.debug ...] result code=102`
              over and over — Manager's WatchdogService retries every 90 s
              via Api34BalLauncher.launchAllowingBackgroundStart() but
              Android 14 BAL requires BOTH the PendingIntent sender AND the
              sending process to have a BAL grant. Manager's FGS doesn't,
              so every relaunch is silently blocked and the kiosk sits on
              the OEM home screen until an operator power-cycles.

              Fix: deliver the launch trigger to a receiver that runs IN
              PLAYER'S OWN PROCESS — same-UID startActivity is exempt from
              BAL. MY_PACKAGE_REPLACED has all the right properties:
                - delivered to the newly-installed package (Player itself)
                - delivered to MANIFEST receivers (not bound to the old
                  process which the install killed)
                - on the documented BAL exemption list (Android 14 docs:
                  ACTION_BOOT_COMPLETED, ACTION_MY_PACKAGE_REPLACED,
                  ACTION_MY_PACKAGE_SUSPENDED, ACTION_MY_PACKAGE_UNSUSPENDED,
                  ACTION_PACKAGE_FIRST_LAUNCH)

              BootReceiver already starts the foreground services + fires
              an OTA check + launches MainActivity. Reusing it means a
              one-line filter add and zero new code — the behavior we want
              for "device just booted" is the same behavior we want for
              "Player just upgraded itself".

              Data-scheme not needed — MY_PACKAGE_REPLACED is sent to your
              OWN package without one (unlike ACTION_PACKAGE_REPLACED which
              you use to OBSERVE other packages and which DOES need
              <data android:scheme="package" />).
            -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- USB sneakernet receiver (Sprint 7B) — fires when a stick is plugged
             into the Android device; UsbIngester scans for /edu-cms-content/. -->
        <receiver
            android:name=".usb.UsbAttachReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </receiver>

        <!-- Operator-facing USB ingest activity (PIN prompt + SAF folder picker) -->
        <activity
            android:name=".usb.UsbIngestActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.EduCmsPlayer" />

        <!-- Foreground heartbeat service. Pings /screens/status every 30s
             so the dashboard sees ONLINE; foregroundServiceType=dataSync
             is the Android 14 contract for periodic network jobs. -->
        <service
            android:name=".heartbeat.HeartbeatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Watchdog alarm receiver — fires every 15min to ensure
             HeartbeatService + the kiosk activity are alive even after
             OEM battery-saver kills. -->
        <receiver
            android:name=".watchdog.WatchdogReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.educms.player.WATCHDOG_TICK" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for the OTA install intent. Android 7+ refuses
             to grant install permission to a file:// uri; everything must
             be served from a content://<authority>/<path> via FileProvider.
             The xml/file_paths.xml whitelist exposes only our private
             external-files /updates dir, never the rest of the device. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Catches PackageInstaller.Session commit results. When the
             OTA worker commits an install, this receiver gets the
             STATUS_SUCCESS / STATUS_PENDING_USER_ACTION / FAILURE_*
             callback, launches the consent prompt if needed, and logs
             the outcome. Exported=false because it's targeted by a
             PendingIntent we ourselves minted, not by any external
             caller. -->
        <receiver
            android:name=".ota.OtaInstallReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.educms.player.OTA_INSTALL_RESULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
