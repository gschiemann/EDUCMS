{
  "name": "renderer",
  "version": "0.1.0",
  "description": "VenueOS board renderer: a complete board HTML document in, a WebP screenshot plus objective design measurements out. No network, no secrets, private network only.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "gen:fonts": "tsc -p tsconfig.build.json && node dist/tools/gen-font-manifest.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/unit/*.test.js dist-test/test/integration/*.test.js",
    "test:unit": "tsc -p tsconfig.test.json && node --test dist-test/test/unit/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/integration/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/arimo": "5.3.0",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/gelasio": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/mulish": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "puppeteer-core": "^25.0.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "playwright-core": "1.59.1",
    "typescript": "^5.7.3"
  }
}
