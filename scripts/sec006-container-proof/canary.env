# SEC-006 in-container proof — FAKE secrets, every value carrying a canary.
#
# These are NOT credentials. Every value contains the literal string
# SEC006-LEAK-CANARY so the proof can assert "this string appears in NO
# process of the render tree" — an absence check that also catches a leak
# smuggled under a different variable name.
#
# The container is started with all of these set, so the parent API process
# genuinely holds them. Without that, "the child has no secrets" would be
# vacuously true.
DEVICE_SECRET_KEY=SEC006-LEAK-CANARY-DEVICE-SECRET-KEY-0000000000000000000000
DEVICE_JWT_SECRET=SEC006-LEAK-CANARY-DEVICE-JWT-SECRET-0000000000000000000000
JWT_SECRET=SEC006-LEAK-CANARY-JWT-SECRET-000000000000000000000000000000
SESSION_SECRET=SEC006-LEAK-CANARY-SESSION-SECRET-000000000000000000000000
DATABASE_URL=postgresql://SEC006-LEAK-CANARY-DBUSER:SEC006-LEAK-CANARY-DBPASS@db.invalid:5432/postgres?connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://SEC006-LEAK-CANARY-DBUSER:SEC006-LEAK-CANARY-DBPASS@db.invalid:5432/postgres
SUPABASE_URL=https://SEC006-LEAK-CANARY.supabase.invalid
SUPABASE_SERVICE_ROLE_KEY=SEC006-LEAK-CANARY-SUPABASE-SERVICE-ROLE-KEY
SUPABASE_ANON_KEY=SEC006-LEAK-CANARY-SUPABASE-ANON-KEY
REDIS_URL=redis://:SEC006-LEAK-CANARY-REDIS@redis.invalid:6379
STRIPE_SECRET_KEY=sk_test_SEC006-LEAK-CANARY-STRIPE
STRIPE_WEBHOOK_SECRET=whsec_SEC006-LEAK-CANARY-STRIPE-WEBHOOK
STRIPE_PRICE_MONTHLY=price_SEC006-LEAK-CANARY
GH_TOKEN=SEC006-LEAK-CANARY-GH-TOKEN
GITHUB_TOKEN=SEC006-LEAK-CANARY-GITHUB-TOKEN
RESEND_API_KEY=re_SEC006-LEAK-CANARY-RESEND
ANTHROPIC_API_KEY=sk-ant-SEC006-LEAK-CANARY
PEXELS_API_KEY=SEC006-LEAK-CANARY-PEXELS
GOOGLE_MAPS_API_KEY=SEC006-LEAK-CANARY-GOOGLE-MAPS
PROXY_RENDER_SECRET=SEC006-LEAK-CANARY-PROXY-RENDER-SECRET
SPORTS_BEACON_SECRET=SEC006-LEAK-CANARY-SPORTS-BEACON
GATEWAY_SHARED_SECRET=SEC006-LEAK-CANARY-GATEWAY-SHARED-SECRET
# Railway sets this for the API. The child must NOT inherit a 4 GB heap.
NODE_OPTIONS=--max-old-space-size=4096
